---
interface Props {
  title?: string;
  description?: string;
  jsonLd?: object;
}

const {
  title = 'Naas Today — Your daily guide to what\'s happening in Naas',
  description = 'Your daily guide to what\'s happening in Naas, County Kildare. Find local events, updated daily.',
  jsonLd,
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="description" content={description}>
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://naastoday.com">
    <meta property="og:site_name" content="Naas Today">
    <meta property="og:locale" content="en_IE">
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48'><rect width='48' height='48' rx='8' fill='%232d5a2d'/><text x='24' y='34' font-size='20' font-family='serif' font-weight='bold' fill='white' text-anchor='middle'>NT</text></svg>">
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <style is:global>
        @import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&display=swap');

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --bg:           #FAFBF6;
            --bg-card:      #FFFFFF;
            --bg-muted:     #F5F0E8;
            --ink:          #1a3a1a;
            --ink-mid:      #6B7A6B;
            --ink-light:    #8B8B7A;
            --accent:       #2d5a2d;
            --accent-light: #E8F0E4;
            --warm:         #8B7355;
            --warm-light:   #F5F0E8;
            --border:       #e0e0d8;
            --border-light: #f0ece4;
            --shadow-sm:    0 1px 3px rgba(0,0,0,0.04);
            --shadow-md:    0 4px 16px rgba(0,0,0,0.06);

            /* Category colors */
            --cat-free:       #2d5a2d;
            --cat-free-bg:    #E8F0E4;
            --cat-kids:       #1565C0;
            --cat-kids-bg:    #E3F2FD;
            --cat-music:      #6B21A8;
            --cat-music-bg:   #F3E8FF;
            --cat-sport:      #0D7C3F;
            --cat-sport-bg:   #DCFCE7;
            --cat-markets:    #8B5E00;
            --cat-markets-bg: #FFF3E0;
            --cat-theatre:    #BE185D;
            --cat-theatre-bg: #FCE7F3;
        }

        body {
            font-family: system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
            background: var(--bg);
            color: var(--ink);
            line-height: 1.6;
            -webkit-font-smoothing: antialiased;
        }

        .container {
            max-width: 1100px;
            margin: 0 auto;
            padding: 0 1.5rem;
        }

        /* ── Header / Masthead ── */
        header {
            background: var(--bg-card);
            border-bottom: 1px solid var(--border-light);
            padding: 1rem 0;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .masthead {
            text-align: center;
            padding: 0.375rem 0 0.25rem;
        }

        h1 {
            font-family: Georgia, serif;
            font-size: clamp(2rem, 4vw, 3rem);
            font-weight: 700;
            color: var(--ink);
            line-height: 1.1;
            letter-spacing: -0.02em;
        }

        .tagline {
            font-size: 0.8125rem;
            color: var(--ink-mid);
            margin-top: 0.25rem;
        }

        /* ── Date Section ── */
        .date-section {
            background: var(--bg);
            border-bottom: 1px solid var(--border);
            padding: 1rem 0;
        }

        .date-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .current-date {
            font-size: 1.375rem;
            font-weight: 600;
            color: var(--warm);
        }

        .date-nav {
            display: flex;
            gap: 0.5rem;
            align-items: center;
        }

        .date-nav-btn {
            background: transparent;
            border: 1.5px solid var(--border);
            color: var(--ink-mid);
            cursor: pointer;
            transition: all 0.15s;
            min-height: 44px;
            min-width: 44px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .date-nav-btn:hover {
            border-color: var(--accent);
            color: var(--accent);
        }

        #prevDay, #nextDay, #todayBtn, #changeDateBtn {
            padding: 0.375rem 0.875rem;
            border-radius: 999px;
            font-size: 0.8125rem;
            font-weight: 500;
        }

        .date-nav-btn.today-btn {
            background: var(--accent-light);
            border-color: var(--accent);
            color: var(--accent);
            font-weight: 600;
        }

        /* ── Controls ── */
        .controls {
            padding: 1.5rem 0 1.25rem;
        }

        .controls-inner {
            display: flex;
            flex-wrap: wrap;
            gap: 0.75rem;
            align-items: center;
        }

        .controls-label {
            font-family: 'DM Mono', monospace;
            font-size: 0.6875rem;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--ink-light);
        }

        .filter-scroll {
            flex: 1;
            min-width: 0;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }

        .filter-group {
            display: flex;
            gap: 0.5rem;
            flex-wrap: nowrap;
        }

        .filter-btn {
            padding: 0.4375rem 1rem;
            border: 1.5px solid var(--border);
            background: var(--bg-card);
            color: var(--ink-mid);
            font-size: 0.8125rem;
            font-weight: 500;
            border-radius: 999px;
            cursor: pointer;
            transition: all 0.15s;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            white-space: nowrap;
        }

        /* Category filter colors via data-cat attribute */
        .filter-btn[data-cat="free"]    { --_cat: var(--cat-free);    --_cat-bg: var(--cat-free-bg); }
        .filter-btn[data-cat="kids"]    { --_cat: var(--cat-kids);    --_cat-bg: var(--cat-kids-bg); }
        .filter-btn[data-cat="music"]   { --_cat: var(--cat-music);   --_cat-bg: var(--cat-music-bg); }
        .filter-btn[data-cat="sport"]   { --_cat: var(--cat-sport);   --_cat-bg: var(--cat-sport-bg); }
        .filter-btn[data-cat="markets"] { --_cat: var(--cat-markets); --_cat-bg: var(--cat-markets-bg); }
        .filter-btn[data-cat="theatre"] { --_cat: var(--cat-theatre); --_cat-bg: var(--cat-theatre-bg); }

        .filter-btn[data-cat]:hover {
            border-color: var(--_cat);
            color: var(--_cat);
            background: var(--_cat-bg);
        }

        .filter-btn[data-cat].active {
            background: var(--_cat);
            color: white;
            border-color: var(--_cat);
        }

        .submit-btn {
            margin-left: auto;
            flex-shrink: 0;
            background: var(--accent);
            border: 1.5px solid var(--accent);
            color: white;
            font-size: 0.8125rem;
            font-weight: 600;
            border-radius: 999px;
            padding: 0.4375rem 1rem;
            cursor: pointer;
            transition: all 0.15s;
            white-space: nowrap;
        }

        .submit-btn:hover {
            background: var(--ink);
            border-color: var(--ink);
        }

        /* ── Events Grid ── */
        .events-container {
            padding: 0 0 4rem;
        }

        .events-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(420px, 1fr));
            gap: 16px;
        }

        /* ── Event Card ── */
        .event-card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 12px;
            box-shadow: var(--shadow-sm);
            transition: box-shadow 0.15s ease, transform 0.15s ease;
            overflow: hidden;
        }

        .event-card:hover {
            box-shadow: var(--shadow-md);
            transform: translateY(-1px);
        }

        .event-card-inner {
            display: flex;
            height: 100%;
        }

        .event-card-sidebar {
            width: 56px;
            flex-shrink: 0;
            background: var(--accent);
            border-radius: 12px 0 0 12px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 0.75rem 0.25rem;
            color: white;
            font-family: 'DM Mono', monospace;
            text-align: center;
            line-height: 1.2;
        }

        .sidebar-time {
            font-size: 1rem;
            font-weight: 500;
        }

        .sidebar-ampm {
            font-size: 0.625rem;
            font-weight: 400;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            opacity: 0.85;
        }

        .sidebar-allday {
            font-size: 0.5625rem;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            writing-mode: vertical-lr;
            text-orientation: mixed;
        }

        .sidebar-multi {
            font-size: 0.5625rem;
            font-weight: 500;
            letter-spacing: 0.02em;
        }

        .event-card-body {
            padding: 1rem 1.25rem;
            flex: 1;
            min-width: 0;
        }

        .event-time-inline {
            display: inline-flex;
            align-items: center;
            background: var(--bg-muted);
            color: var(--warm);
            font-family: 'DM Mono', monospace;
            font-size: 0.6875rem;
            font-weight: 500;
            padding: 0.1875rem 0.5rem;
            border-radius: 999px;
            letter-spacing: 0.03em;
            margin-bottom: 0.5rem;
        }

        .event-title {
            font-size: 0.9375rem;
            font-weight: 600;
            color: var(--ink);
            margin-bottom: 0.25rem;
            line-height: 1.35;
        }

        .event-location {
            color: var(--ink-mid);
            font-size: 0.75rem;
            font-weight: 500;
            margin-bottom: 0.5rem;
            display: flex;
            align-items: center;
            gap: 0.25rem;
        }

        a.event-location {
            text-decoration: none;
            color: var(--ink-mid);
        }

        a.event-location:hover {
            color: var(--accent);
            text-decoration: underline;
        }

        .event-description {
            color: var(--ink-light);
            line-height: 1.55;
            margin-bottom: 0.75rem;
            font-size: 0.75rem;
            white-space: pre-wrap;
        }
        .event-description.is-truncatable {
            display: -webkit-box;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
        .event-description.is-truncatable.is-collapsed {
            -webkit-line-clamp: 3;
            white-space: normal;
        }
        .desc-toggle-btn {
            display: block;
            background: none;
            border: none;
            padding: 0;
            margin-top: 0.25rem;
            margin-bottom: 0.75rem;
            color: var(--accent);
            font-size: 0.75rem;
            font-weight: 500;
            cursor: pointer;
            text-align: left;
        }
        .desc-toggle-btn:hover {
            color: var(--ink);
        }

        .event-url {
            display: inline-block;
            color: var(--accent);
            font-size: 0.75rem;
            text-decoration: none;
            margin-bottom: 0.75rem;
        }

        .event-url:hover {
            color: var(--ink);
            text-decoration: underline;
        }

        .card-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 0.5rem;
            min-height: 28px;
        }

        .event-tags {
            display: flex;
            gap: 0.375rem;
            flex-wrap: wrap;
        }

        .tag {
            padding: 0.125rem 0.5rem;
            border-radius: 999px;
            font-size: 0.625rem;
            font-family: 'DM Mono', monospace;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.06em;
        }

        .tag.free    { background: var(--cat-free-bg);    color: var(--cat-free); }
        .tag.kids    { background: var(--cat-kids-bg);    color: var(--cat-kids); }
        .tag.music   { background: var(--cat-music-bg);   color: var(--cat-music); }
        .tag.sport   { background: var(--cat-sport-bg);   color: var(--cat-sport); }
        .tag.market  { background: var(--cat-markets-bg); color: var(--cat-markets); }
        .tag.theatre { background: var(--cat-theatre-bg); color: var(--cat-theatre); }

        .share-btn {
            background: none;
            border: none;
            color: var(--ink-light);
            font-size: 0.6875rem;
            font-weight: 500;
            cursor: pointer;
            padding: 0.25rem 0;
            transition: color 0.15s;
            white-space: nowrap;
        }

        .share-btn:hover {
            color: var(--accent);
        }

        /* ── Upcoming Section ─────────────────────────────────────────── */
        .upcoming-section {
            margin-top: 2rem;
            border-top: 1px solid var(--border-light);
            padding-top: 1.25rem;
            padding-bottom: 2rem;
        }
        .upcoming-heading {
            font-family: Georgia, serif;
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--ink);
            margin: 0 0 0.75rem;
        }
        .upcoming-list {
            list-style: none;
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            gap: 0;
        }
        .upcoming-item {
            display: grid;
            grid-template-columns: 7rem 3.5rem 1fr auto;
            gap: 0.5rem;
            align-items: center;
            padding: 0.5rem 0.5rem;
            border-radius: 6px;
            cursor: pointer;
            transition: background 0.12s;
        }
        .upcoming-item:hover, .upcoming-item:focus-visible {
            background: var(--bg-muted);
            outline: none;
        }
        .upcoming-date {
            font-size: 0.8125rem;
            color: var(--ink-mid);
            white-space: nowrap;
        }
        .upcoming-time {
            font-size: 0.75rem;
            font-family: 'DM Mono', monospace;
            color: var(--ink-mid);
            white-space: nowrap;
        }
        .upcoming-title {
            font-size: 0.875rem;
            font-weight: 500;
            color: var(--ink);
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        .upcoming-location {
            font-size: 0.75rem;
            color: var(--ink-mid);
            text-align: right;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            max-width: 8rem;
        }
        @media (max-width: 480px) {
            .upcoming-item {
                grid-template-columns: 1fr auto;
                grid-template-rows: auto auto;
            }
            .upcoming-date { grid-column: 1; grid-row: 1; }
            .upcoming-time { grid-column: 2; grid-row: 1; text-align: right; }
            .upcoming-title { grid-column: 1; grid-row: 2; }
            .upcoming-location { grid-column: 2; grid-row: 2; }
        }

        /* ── Card load animation ── */
        @keyframes cardFadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        .event-card:nth-child(1) { animation: cardFadeIn 0.3s ease both 0ms; }
        .event-card:nth-child(2) { animation: cardFadeIn 0.3s ease both 40ms; }
        .event-card:nth-child(3) { animation: cardFadeIn 0.3s ease both 80ms; }
        .event-card:nth-child(4) { animation: cardFadeIn 0.3s ease both 120ms; }
        .event-card:nth-child(5) { animation: cardFadeIn 0.3s ease both 160ms; }
        .event-card:nth-child(6) { animation: cardFadeIn 0.3s ease both 200ms; }
        .event-card:nth-child(7) { animation: cardFadeIn 0.3s ease both 240ms; }
        .event-card:nth-child(8) { animation: cardFadeIn 0.3s ease both 280ms; }

        @media (prefers-reduced-motion: reduce) {
            .event-card { animation: none; }
        }

        /* ── Time mode selector in submit form ── */
        .time-mode-group {
            display: flex;
            gap: 1.25rem;
            margin-top: 0.5rem;
            margin-bottom: 0.75rem;
            flex-wrap: wrap;
        }

        .radio-label {
            display: flex;
            align-items: center;
            gap: 0.375rem;
            font-size: 0.875rem;
            font-weight: 400;
            cursor: pointer;
        }

        .radio-label input[type="radio"] {
            width: auto;
            cursor: pointer;
        }

        .time-inputs {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .time-inputs input[type="time"] {
            flex: 1;
        }

        .time-sep {
            color: var(--ink-mid);
            font-size: 0.875rem;
            white-space: nowrap;
        }

        .form-hint {
            font-weight: 400;
            color: var(--ink-mid);
        }

        /* ── Loading State ── */
        .loading-state {
            text-align: center;
            padding: 4rem 2rem;
            display: none;
            color: var(--ink-mid);
            font-size: 0.9375rem;
        }

        .loading-state.visible {
            display: block;
        }

        .skeleton-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(420px, 1fr));
            gap: 16px;
        }

        .skeleton-card {
            display: flex;
            border: 1px solid var(--border);
            border-radius: 12px;
            overflow: hidden;
            background: var(--bg-card);
        }

        .skeleton-sidebar {
            width: 56px;
            flex-shrink: 0;
            background: var(--accent-light);
            animation: skeletonPulse 1.5s ease-in-out infinite;
        }

        .skeleton-body {
            flex: 1;
            padding: 1rem 1.25rem;
        }

        .skeleton-line {
            border-radius: 4px;
            background: var(--border-light);
            animation: skeletonPulse 1.5s ease-in-out infinite;
        }

        .skeleton-title { height: 16px; width: 70%; margin-bottom: 10px; }
        .skeleton-loc { height: 12px; width: 50%; margin-bottom: 12px; }
        .skeleton-desc { height: 10px; width: 90%; margin-bottom: 6px; }
        .skeleton-desc-short { height: 10px; width: 60%; }

        @keyframes skeletonPulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.4; }
        }

        .loading-spinner {
            width: 32px;
            height: 32px;
            border: 3px solid var(--border);
            border-top-color: var(--accent);
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
            margin: 0 auto 1rem;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        /* ── Empty State ── */
        .empty-state {
            text-align: center;
            padding: 4rem 2rem;
            display: none;
        }

        .empty-state.visible {
            display: block;
        }

        .empty-icon {
            margin-bottom: 1rem;
        }

        .empty-state h3 {
            font-family: Georgia, serif;
            font-weight: 700;
            font-size: 1.5rem;
            color: var(--ink);
            margin-bottom: 0.5rem;
        }

        .empty-state p {
            color: var(--ink-light);
        }

        /* ── Footer ── */
        footer {
            border-top: 1px solid var(--border-light);
            padding: 2rem 0;
            margin-top: 3rem;
        }

        .footer-content {
            text-align: center;
            font-size: 13px;
            color: var(--ink-mid);
        }

        .footer-links {
            display: flex;
            justify-content: center;
            gap: 0;
            flex-wrap: wrap;
            margin-bottom: 0.5rem;
        }

        .footer-links a,
        .footer-links button {
            color: var(--ink-mid);
            text-decoration: none;
            background: none;
            border: none;
            padding: 0;
            font-size: 13px;
            cursor: pointer;
            transition: color 0.2s;
        }

        .footer-links a:hover,
        .footer-links button:hover {
            color: var(--accent);
        }

        .footer-dot {
            color: var(--ink-light);
            margin: 0 0.5rem;
        }

        /* ── Modals ── */
        .modal {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(26, 58, 26, 0.4);
            z-index: 1000;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1rem;
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
            transition: opacity 0.2s ease, visibility 0.2s ease;
        }

        .modal.active {
            opacity: 1;
            visibility: visible;
            pointer-events: auto;
        }

        .modal-content {
            background: var(--bg-card);
            border-radius: 16px;
            max-width: 540px;
            width: 100%;
            max-height: 90vh;
            overflow-y: auto;
            box-shadow: 0 20px 60px rgba(0,0,0,0.12), 0 8px 24px rgba(0,0,0,0.08);
            border: 1px solid var(--border);
            transform: scale(0.95);
            transition: transform 0.2s ease;
        }

        .modal.active .modal-content {
            transform: scale(1);
        }

        .modal-header {
            padding: 1.25rem 1.5rem;
            border-bottom: 1px solid var(--border-light);
            background: var(--bg-muted);
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-radius: 16px 16px 0 0;
        }

        .modal-header h2 {
            font-family: Georgia, serif;
            font-size: 1.375rem;
            font-weight: 700;
            color: var(--ink);
        }

        .modal-close {
            background: none;
            border: 1px solid transparent;
            font-size: 1.25rem;
            color: var(--ink-mid);
            cursor: pointer;
            padding: 0;
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            transition: all 0.2s;
        }

        .modal-close:hover {
            color: var(--accent);
        }

        .modal-body {
            padding: 1.5rem;
        }

        .modal-body p {
            color: var(--ink-mid);
            margin-bottom: 1.5rem;
        }

        /* ── Form Elements ── */
        .form-group {
            margin-bottom: 1.25rem;
        }

        .form-group label {
            display: block;
            margin-bottom: 0.5rem;
            color: var(--ink);
            font-weight: 500;
            font-size: 0.875rem;
        }

        .form-group input,
        .form-group textarea,
