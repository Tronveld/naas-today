---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import DateNav from '../components/DateNav.astro';
import FilterControls from '../components/FilterControls.astro';
import EventsGrid from '../components/EventsGrid.astro';
import Footer from '../components/Footer.astro';
import DatePickerModal from '../components/modals/DatePickerModal.astro';
import SubmitEventModal from '../components/modals/SubmitEventModal.astro';
import AboutModal from '../components/modals/AboutModal.astro';
import ContactModal from '../components/modals/ContactModal.astro';

const SUPABASE_URL = import.meta.env.SUPABASE_URL;
const SUPABASE_ANON_KEY = import.meta.env.SUPABASE_ANON_KEY;

let initialEvents: any[] = [];
try {
  if (SUPABASE_URL && SUPABASE_ANON_KEY) {
    const res = await fetch(
      `${SUPABASE_URL}/rest/v1/events?status=eq.approved&order=date.asc,time.asc&select=id,title,date,end_date,time,time_end,is_all_day,location,description,is_free,is_for_kids,is_music,is_sport,is_market,is_theatre,url`,
      { headers: { apikey: SUPABASE_ANON_KEY, Authorization: `Bearer ${SUPABASE_ANON_KEY}` } }
    );
    if (res.ok) initialEvents = await res.json();
  }
} catch (e) {
  // silently fall back to empty array; client-side fetch will populate
}

// "Today" means today in Naas, not on the build server (Netlify builds in UTC).
// toISOString() would return yesterday's date for any build run between midnight
// and 1am Irish summer time, pre-rendering the wrong day's events and JSON-LD.
// en-CA gives YYYY-MM-DD.
const todayStr = new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Dublin' }).format(new Date());
const todayEvents = initialEvents.filter(e => {
  if (e.end_date) return e.date <= todayStr && e.end_date >= todayStr;
  return e.date === todayStr;
});

// "Coming Up" is built client-side by renderUpcoming(), but the static HTML shipped a
// heading over an empty <ul>. First paint, no-JS visitors and anything slow enough to
// see the pre-rendered page got a promise with nothing under it — on the section that
// most often holds the only answer, since most weekdays in Naas have no events at all.
//
// This mirrors renderUpcoming() rather than improving on it, because the client replaces
// the list on load and any difference would show as a flicker. That means: compare on
// `date` alone (a multi-day run that started before today is deliberately not "upcoming",
// matching the client), take the first five, and lean on the query's date.asc,time.asc
// ordering instead of re-sorting.
const upcomingEvents = initialEvents.filter(e => e.date > todayStr).slice(0, 5);

function upcomingDateLabel(dateStr: string): string {
  return new Date(dateStr + 'T00:00:00').toLocaleDateString('en-IE', {
    weekday: 'short',
    month: 'short',
    day: 'numeric',
  });
}

function upcomingTimeLabel(event: any): string {
  if (event.is_all_day) return 'All day';
  return event.time ? event.time.substring(0, 5) : '';
}

// Build JSON-LD for today's events
const jsonLd = todayEvents.length > 0 ? {
  '@context': 'https://schema.org',
  '@graph': todayEvents.map(e => ({
    '@type': 'Event',
    name: e.title,
    startDate: e.date + (e.is_all_day || !e.time ? '' : 'T' + e.time.substring(0, 5)),
    ...(e.end_date ? { endDate: e.end_date } : {}),
    location: {
      '@type': 'Place',
      name: e.location,
      address: { '@type': 'PostalAddress', addressLocality: 'Naas', addressCountry: 'IE' }
    },
    description: e.description,
    isAccessibleForFree: e.is_free,
    organizer: { '@type': 'Organization', name: 'Naas Today' }
  }))
} : undefined;
---

<BaseLayout jsonLd={jsonLd}>
  <a href="#main-content" class="skip-link">Skip to main content</a>
  <Header />
  <DateNav />
  <main id="main-content" role="main" class="container">
    <FilterControls />
    <h2 class="visually-hidden" id="events-list-heading">Today's events</h2>
    <EventsGrid events={initialEvents} todayStr={todayStr} />
    <section
      id="upcomingSection"
      class="upcoming-section"
      aria-label="Coming up"
      style={upcomingEvents.length === 0 ? 'display:none' : undefined}
    >
      <h2 class="upcoming-heading" id="upcomingHeading">{todayEvents.length === 0 ? 'Next up' : 'Coming Up'}</h2>
      {/* renderUpcoming() replaces these rows on load and adds the click/keyboard
          handling. They ship without role="button"/tabindex on purpose: without JS
          those attributes would announce a control that cannot do anything. */}
      <ul id="upcomingList" class="upcoming-list">
        {upcomingEvents.map(event => (
          <li class="upcoming-item">
            <span class="upcoming-date">{upcomingDateLabel(event.date)}</span>
            <span class="upcoming-time">{upcomingTimeLabel(event)}</span>
            <span class="upcoming-title">{event.title}</span>
            <span class="upcoming-location">{event.location}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- The empty day's submit prompt, deliberately after the upcoming list.
         DESIGN.md's page-order rule puts the CTA after the day's events so the
         visitor's job comes first; on a day with no events that job is answered
         by the list above, not by the empty grid, so the CTA follows it here. -->
    <div class="empty-cta" id="emptyCta" hidden={todayEvents.length > 0}>
      <p>Know of something happening? Add it to the noticeboard.</p>
      <button class="submit-area-btn" id="emptySubmitBtn">Submit an event</button>
    </div>
  </main>
  <Footer />
  <DatePickerModal />
  <SubmitEventModal />
  <AboutModal />
  <ContactModal />

  <!-- Expose build-time events to client JS -->
  <script define:vars={{ initialEvents }}>
    window.__INITIAL_EVENTS__ = initialEvents;
  </script>

  <script>
    import { apply as applyDraft, saveDraft, hasDraft, clearDraft, readDraft } from '../scripts/draft.js';

    // ── Utilities ──────────────────────────────────────────────────────

    // Decodes HTML entities (e.g. &eacute; → é) safely via a textarea element
    function decodeHTML(str) {
        if (!str) return str;
        const t = document.createElement('textarea');
        t.innerHTML = str;
        return t.value;
    }

    // Returns the local date as YYYY-MM-DD (avoids UTC offset issues with toISOString)
    function localDateStr(date) {
        const d = date instanceof Date ? date : new Date(date);
        const y = d.getFullYear();
        const m = String(d.getMonth() + 1).padStart(2, '0');
        const day = String(d.getDate()).padStart(2, '0');
        return `${y}-${m}-${day}`;
    }

    const DESC_THRESHOLD = 220;

    function setupDescriptionToggle(p) {
        if (p.dataset.toggleInit === 'true') return;
        p.dataset.toggleInit = 'true';
        const btn = p.nextElementSibling;
        if (!btn || !btn.classList.contains('desc-toggle-btn')) return;
        p.classList.add('is-truncatable', 'is-collapsed');
        btn.addEventListener('click', () => {
            const collapsed = p.classList.toggle('is-collapsed');
            btn.textContent = collapsed ? 'Read more ↓' : 'Show less ↑';
            btn.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
        });
    }

    function initDescriptionToggles(root) {
        root.querySelectorAll('p.event-description[data-truncatable="true"]').forEach(setupDescriptionToggle);
    }

    // ── State ───────────────────────────────────────────────────────────
    // Use build-time events as initial state (mapped to camelCase)
    let events = (window.__INITIAL_EVENTS__ || []).map((row, index) => ({
        id: row.id || index + 1,
        title: decodeHTML(row.title || ''),
        date: row.date || '',
        endDate: row.end_date || '',
        time: row.time ? row.time.substring(0, 5) : '',
        timeEnd: row.time_end ? row.time_end.substring(0, 5) : '',
        isAllDay: Boolean(row.is_all_day),
        location: decodeHTML(row.location || ''),
        description: decodeHTML(row.description || ''),
        isFree: Boolean(row.is_free),
        isForKids: Boolean(row.is_for_kids),
        isMusic:   Boolean(row.is_music),
        isSport:   Boolean(row.is_sport),
        isMarket:  Boolean(row.is_market),
        isTheatre: Boolean(row.is_theatre),
        url: row.url || ''
    }));
    let currentDate = new Date();
    let filterFreeActive    = false;
    let filterKidsActive    = false;
    let filterMusicActive   = false;
    let filterSportActive   = false;
    let filterMarketActive  = false;
    let filterTheatreActive = false;
    let isError = false;

    // The six category chips, in row order. Only used for the count badges — the
    // toggle handlers and URL state still name their own variables, because those
    // are six separate `let`s and collapsing them is a bigger change than this.
    const FILTER_CHIPS = [
        { id: 'filterFree',    label: 'Free',     match: e => e.isFree },
        { id: 'filterKids',    label: 'For kids', match: e => e.isForKids },
        { id: 'filterMusic',   label: 'Music',    match: e => e.isMusic },
        { id: 'filterSport',   label: 'Sport',    match: e => e.isSport },
        { id: 'filterMarket',  label: 'Markets',  match: e => e.isMarket },
        { id: 'filterTheatre', label: 'Theatre',  match: e => e.isTheatre },
    ];

    function pushUrlState() {
        const params = new URLSearchParams();
        const todayStr = localDateStr(new Date());
        const dateStr = localDateStr(currentDate);
        if (dateStr !== todayStr) params.set('date', dateStr);
        const activeFilters = [
            filterFreeActive    && 'free',
            filterKidsActive    && 'kids',
            filterMusicActive   && 'music',
            filterSportActive   && 'sport',
            filterMarketActive  && 'markets',
            filterTheatreActive && 'theatre',
        ].filter(Boolean);
        if (activeFilters.length) params.set('filters', activeFilters.join(','));
        // Preserve ?event= deep link param if present
        const eventParam = new URLSearchParams(location.search).get('event');
        if (eventParam) params.set('event', eventParam);
        const qs = params.toString();
        history.pushState(null, '', qs ? '?' + qs : location.pathname);
    }

    function readUrlState() {
        const params = new URLSearchParams(location.search);
        const dateParam = params.get('date');
        if (dateParam && /^\d{4}-\d{2}-\d{2}$/.test(dateParam)) {
            const d = new Date(dateParam + 'T00:00:00');
            if (!isNaN(d.getTime())) currentDate = d;
        }
        const filtersParam = params.get('filters');
        if (filtersParam) {
            const active = new Set(filtersParam.split(','));
            filterFreeActive    = active.has('free');
            filterKidsActive    = active.has('kids');
            filterMusicActive   = active.has('music');
            filterSportActive   = active.has('sport');
            filterMarketActive  = active.has('markets');
            filterTheatreActive = active.has('theatre');
            syncFilterButtons();
        }
    }

    // Pushes the six filter flags back onto their buttons. Shared by readUrlState
    // and the empty state's "Show all events" escape.
    function syncFilterButtons() {
        const map = [
            ['filterFree',    filterFreeActive],
            ['filterKids',    filterKidsActive],
            ['filterMusic',   filterMusicActive],
            ['filterSport',   filterSportActive],
            ['filterMarket',  filterMarketActive],
            ['filterTheatre', filterTheatreActive],
        ];
        map.forEach(([id, isActive]) => {
            const btn = document.getElementById(id);
            if (!btn) return;
            btn.classList.toggle('active', isActive);
            btn.setAttribute('aria-pressed', String(isActive));
        });
    }

    function clearAllFilters() {
        filterFreeActive = filterKidsActive = filterMusicActive = false;
        filterSportActive = filterMarketActive = filterTheatreActive = false;
        syncFilterButtons();
        renderEvents();
        pushUrlState();
    }

    // ── Loading State ───────────────────────────────────────────────────
    function showLoading() {
        document.getElementById('eventsGrid').style.display = 'none';
        document.getElementById('emptyState').classList.remove('visible');
        document.getElementById('loadingState').classList.add('visible');
        const submitArea = document.getElementById('submitArea');
        if (submitArea) submitArea.style.display = 'none';
    }

    function hideLoading() {
        document.getElementById('loadingState').classList.remove('visible');
    }

    // ── Data Fetching ───────────────────────────────────────────────────
    async function fetchEvents() {
        // Only show loading spinner if no pre-rendered content is visible
        if (events.length === 0) showLoading();
        isError = false;
        try {
            const response = await fetch('/.netlify/functions/get-events');
            if (!response.ok) throw new Error(`Failed to fetch: ${response.status}`);
            const data = await response.json();
            if (Array.isArray(data) && data.length > 0) {
                events = data.map((row, index) => ({
                    id: row.id || index + 1,
                    title: decodeHTML(row.title || ''),
                    date: row.date || '',
                    endDate: row.end_date || '',
                    time: row.time ? row.time.substring(0, 5) : '',
                    timeEnd: row.time_end ? row.time_end.substring(0, 5) : '',
                    isAllDay: Boolean(row.is_all_day),
                    location: decodeHTML(row.location || ''),
                    description: decodeHTML(row.description || ''),
                    isFree: Boolean(row.is_free),
                    isForKids: Boolean(row.is_for_kids),
                    isMusic:   Boolean(row.is_music),
                    isSport:   Boolean(row.is_sport),
                    isMarket:  Boolean(row.is_market),
                    isTheatre: Boolean(row.is_theatre),
                    url: row.url || ''
                }));
            }
        } catch (error) {
            console.error('Error fetching events:', error);
            // Only show error state if we have no pre-rendered events
            if (events.length === 0) {
                isError = true;
            }
        }
        populateLocationSuggestions();
        renderEvents();
    }

    function populateLocationSuggestions() {
        const dl = document.getElementById('location-suggestions');
        if (!dl) return;
        const locations = [...new Set(events.map(e => e.location).filter(Boolean))].sort();
        dl.replaceChildren(...locations.map(loc => {
            const opt = document.createElement('option');
            opt.value = loc;
            return opt;
        }));
    }

    // ── Rendering ───────────────────────────────────────────────────────
    function formatDateDisplay(date) {
        const today = new Date();
        today.setHours(0, 0, 0, 0);
        const compareDate = new Date(date);
        compareDate.setHours(0, 0, 0, 0);
        // The year is dropped for dates in the current year — it is redundant and
        // pushes the line to two rows on 320px phones. Kept when it is not.
        const dateOpts = { day: 'numeric', month: 'long' };
        if (date.getFullYear() !== today.getFullYear()) dateOpts.year = 'numeric';
        if (compareDate.getTime() === today.getTime()) {
            const dayName = date.toLocaleDateString('en-IE', { weekday: 'long' });
            return `Today – ${dayName}, ${date.toLocaleDateString('en-IE', dateOpts)}`;
        }
        const tomorrow = new Date(today);
        tomorrow.setDate(tomorrow.getDate() + 1);
        if (compareDate.getTime() === tomorrow.getTime()) {
            return `Tomorrow – ${date.toLocaleDateString('en-IE', dateOpts)}`;
        }
        return date.toLocaleDateString('en-IE', { weekday: 'long', ...dateOpts });
    }

    function formatTime(time) {
        const [hours, minutes] = time.split(':');
        const hour = parseInt(hours);
        const ampm = hour >= 12 ? 'PM' : 'AM';
        const displayHour = hour % 12 || 12;
        return `${displayHour}:${minutes} ${ampm}`;
    }

    function formatEventTime(event) {
        if (event.isAllDay) return 'All day';
        if (!event.time) return '';
        const start = formatTime(event.time);
        if (event.timeEnd) return start + ' – ' + formatTime(event.timeEnd);
        return start;
    }

    function formatDateForShare(dateStr) {
        const d = new Date(dateStr + 'T00:00:00');
        return d.toLocaleDateString('en-IE', { weekday: 'long', day: 'numeric', month: 'long' });
    }

    function shareEvent(event) {
        const timeStr = formatEventTime(event);
        const dateDisplay = formatDateForShare(event.date);
        const when = timeStr ? `${dateDisplay} · ${timeStr}` : dateDisplay;
        const text = `${event.title}\n${when}\n${event.location}`;
        const url = `${location.origin}${location.pathname}?event=${event.id}`;
        if (navigator.share) {
            navigator.share({ title: event.title, text, url }).catch(() => {});
        } else {
            window.open(`https://wa.me/?text=${encodeURIComponent(text + '\n\n' + url)}`, '_blank');
        }
    }

    function formatTimeShort(time) {
        const [hours, minutes] = time.split(':');
        const hour = parseInt(hours);
        const ampm = hour >= 12 ? 'PM' : 'AM';
        const displayHour = hour % 12 || 12;
        return { time: `${displayHour}:${minutes}`, ampm };
    }

    function formatDateShort(dateStr) {
        const d = new Date(dateStr + 'T00:00:00');
        return d.toLocaleDateString('en-IE', { day: 'numeric', month: 'short' });
    }

    // Builds an event card using DOM methods (avoids XSS from raw data)
    function createEventCard(event) {
        const card = document.createElement('article');
        card.className = 'event-card';
        card.dataset.eventId = event.id;
        card.setAttribute('aria-labelledby', 'event-title-' + event.id);

        // Top row: title + inline time/allday badge
        const top = document.createElement('div');
        top.className = 'ev-top';

        const title = document.createElement('h3');
        title.className = 'event-title';
        title.id = 'event-title-' + event.id;
        title.textContent = event.title;
        top.appendChild(title);

        const isMultiDay = event.endDate && event.endDate !== event.date;
        const hasTime = event.time && !event.isAllDay;

        if (event.isAllDay) {
            const t = document.createElement('span');
            t.className = 'ev-allday';
            t.textContent = 'ALL DAY';
            top.appendChild(t);
        } else if (isMultiDay && !event.isAllDay) {
            const t = document.createElement('span');
            t.className = 'ev-allday';
            t.textContent = formatDateShort(event.date) + ' – ' + formatDateShort(event.endDate);
            top.appendChild(t);
        } else if (hasTime) {
            const st = formatTimeShort(event.time);
            const t = document.createElement('span');
            t.className = 'ev-time';
            t.textContent = st.time + ' ' + st.ampm;
            top.appendChild(t);
        } else {
            const t = document.createElement('span');
            t.className = 'ev-allday';
            t.textContent = 'TBC';
            top.appendChild(t);
        }
        card.appendChild(top);

        const loc = document.createElement('a');
        loc.className = 'event-location';
        loc.href = `https://maps.google.com/?q=${encodeURIComponent(event.location + ', Naas, Ireland')}`;
        loc.target = '_blank';
        loc.rel = 'noopener noreferrer';
        const pin = document.createElement('span');
        pin.setAttribute('aria-hidden', 'true');
        pin.textContent = '📍';
        loc.appendChild(pin);
        loc.appendChild(document.createTextNode(' ' + event.location));
        card.appendChild(loc);

        const descText = event.description || '';
        const isLong = descText.length > DESC_THRESHOLD;
        const desc = document.createElement('p');
        desc.className = 'event-description';
        desc.textContent = descText;
        if (isLong) {
            desc.dataset.truncatable = 'true';
            desc.style.marginBottom = '0';
        }
        card.appendChild(desc);
        if (isLong) {
            const toggleBtn = document.createElement('button');
            toggleBtn.className = 'desc-toggle-btn';
            toggleBtn.type = 'button';
            toggleBtn.textContent = 'Read more ';
            const downArrow = document.createElement('span');
            downArrow.setAttribute('aria-hidden', 'true');
            downArrow.textContent = '↓';
            toggleBtn.appendChild(downArrow);
            toggleBtn.setAttribute('aria-expanded', 'false');
            card.appendChild(toggleBtn);
        }

        if (event.url) {
            try {
                const parsed = new URL(event.url);
                if (['http:', 'https:'].includes(parsed.protocol)) {
                    const urlEl = document.createElement('a');
                    urlEl.className = 'event-url';
                    urlEl.href = parsed.href;
                    urlEl.target = '_blank';
                    urlEl.rel = 'noopener noreferrer';
                    urlEl.textContent = parsed.hostname.replace(/^www\./, '') + ' ';
                    const extArrow = document.createElement('span');
                    extArrow.setAttribute('aria-hidden', 'true');
                    extArrow.textContent = '↗';
                    urlEl.appendChild(extArrow);
                    card.appendChild(urlEl);
                }
            } catch {
                // Invalid URL — skip
            }
        }

        const footer = document.createElement('div');
        footer.className = 'card-footer';

        const tags = document.createElement('div');
        tags.className = 'event-tags';
        const tagDefs = [
            [event.isFree,     'free',    'Free'],
            [event.isForKids,  'kids',    'For kids'],
            [event.isMusic,    'music',   'Music'],
            [event.isSport,    'sport',   'Sport'],
            [event.isMarket,   'market',  'Markets'],
            [event.isTheatre,  'theatre', 'Theatre'],
        ];
        tagDefs.forEach(([flag, cls, label]) => {
            if (flag) {
                const tag = document.createElement('span');
                tag.className = 'tag ' + cls;
                tag.textContent = label;
                tags.appendChild(tag);
            }
        });
        footer.appendChild(tags);

        const shareBtn = document.createElement('button');
        shareBtn.className = 'share-btn';
        shareBtn.textContent = 'Share ';
        const shareArrow = document.createElement('span');
        shareArrow.setAttribute('aria-hidden', 'true');
        shareArrow.textContent = '↗';
        shareBtn.appendChild(shareArrow);
        shareBtn.setAttribute('aria-label', `Share ${event.title}`);
        shareBtn.addEventListener('click', () => shareEvent(event));
        footer.appendChild(shareBtn);

        card.appendChild(footer);
        return card;
    }

    function renderEvents() {
        hideLoading();
        const grid = document.getElementById('eventsGrid');
        const emptyState = document.getElementById('emptyState');
        const errorState = document.getElementById('errorState');
        const submitArea = document.getElementById('submitArea');
        const dateStr = localDateStr(currentDate);

        if (isError) {
            grid.style.display = 'none';
            emptyState.classList.remove('visible');
            errorState.classList.add('visible');
            // The error state has its own Try again button below it.
            if (submitArea) submitArea.style.display = 'none';
            setEmptyCtaHidden(true);
            updateJsonLd([]);
            renderUpcoming();
            announce('Could not load events.');
            return;
        }
        errorState.classList.remove('visible');

        let filteredEvents = events.filter(event => {
            if (event.endDate) {
                return event.date <= dateStr && event.endDate >= dateStr;
            }
            return event.date === dateStr;
        });

        // Held before the category filters are applied, so an empty result can tell
        // "nothing is on today" from "your filters hid everything". Only one of those
        // is the visitor's to fix, and saying the wrong one reads as a broken site.
        const dayEvents = filteredEvents;

        // Count badges. A zero-count chip is dimmed rather than left as a bare
        // label — see the .is-empty rule in BaseLayout for why not disabled.
        // Counts are taken before the category filters are applied, so they
        // always mean "events today with this tag", not "…that also survive
        // your other chips". A chip can therefore be both .active and .is-empty.
        FILTER_CHIPS.forEach(({ id, label, match }) => {
            const count = filteredEvents.filter(match).length;
            const btn = document.getElementById(id);
            btn.querySelector('span').textContent = count > 0 ? `${label} (${count})` : label;
            btn.classList.toggle('is-empty', count === 0);
        });

        if (filterFreeActive)    filteredEvents = filteredEvents.filter(e => e.isFree);
        if (filterKidsActive)    filteredEvents = filteredEvents.filter(e => e.isForKids);
        if (filterMusicActive)   filteredEvents = filteredEvents.filter(e => e.isMusic);
        if (filterSportActive)   filteredEvents = filteredEvents.filter(e => e.isSport);
        if (filterMarketActive)  filteredEvents = filteredEvents.filter(e => e.isMarket);
        if (filterTheatreActive) filteredEvents = filteredEvents.filter(e => e.isTheatre);

        if (filteredEvents.length === 0) {
            grid.style.display = 'none';
            emptyState.classList.add('visible');
            // The submit prompt for an empty day lives after the upcoming list.
            if (submitArea) submitArea.style.display = 'none';
            setEmptyState(dayEvents.length);
            updateJsonLd([]);
            renderUpcoming();
            return;
        }

        grid.style.display = 'grid';
        emptyState.classList.remove('visible');
        if (submitArea) submitArea.style.display = '';
        setEmptyCtaHidden(true);
        filteredEvents.sort((a, b) => a.time.localeCompare(b.time));
        grid.innerHTML = '';
        filteredEvents.forEach(event => grid.appendChild(createEventCard(event)));
        initDescriptionToggles(grid);
        updateJsonLd(filteredEvents);
        renderUpcoming();
        announce(`${filteredEvents.length} ${filteredEvents.length === 1 ? 'event' : 'events'}.`);
    }

    // Announces the outcome as a short count. The live region used to wrap the whole
    // list, so every filter tap re-read each card in full, descriptions included.
    function announce(text) {
        const status = document.getElementById('eventsStatus');
        if (status) status.textContent = text;
    }

    function setEmptyCtaHidden(hidden) {
        const cta = document.getElementById('emptyCta');
        if (cta) cta.hidden = hidden;
    }

    // An empty day has two causes and they need different words. Telling someone
    // "nothing listed" when four events are sitting behind a filter they set is
    // false, and the filter row is not sticky, so they cannot see what caused it.
    function setEmptyState(dayCount) {
        const heading  = document.getElementById('emptyHeading');
        const message  = document.getElementById('emptyMessage');
        const clearBtn = document.getElementById('clearFiltersBtn');
        const filtersHidThem = dayCount > 0;
        // "today" is only true on the day itself; the visitor can be three taps into
        // next week. The date sits right above this message, so a wrong word here is
        // the kind of small lie that makes the rest look unreliable.
        const isToday = localDateStr(currentDate) === localDateStr(new Date());
        const dayWord = isToday ? 'today' : 'this day';
        // "today" already carries its own preposition — "on today" is not English,
        // and reads as broken to exactly the older resident this is built for.
        const dayPhrase = isToday ? 'today' : 'on this day';

        if (filtersHidThem) {
            heading.textContent = 'No matching events';
            message.textContent = dayCount === 1
                ? `There is 1 other event ${dayPhrase}.`
                : `There are ${dayCount} other events ${dayPhrase}.`;
            clearBtn.hidden = false;
            // Not the moment to ask for a submission — the day is not empty.
            setEmptyCtaHidden(true);
            announce(`No matching events. ${dayCount} ${dayCount === 1 ? 'event' : 'events'} hidden by filters.`);
        } else {
            heading.textContent = 'Quiet day in Naas';
            message.textContent = `Nothing listed for ${dayWord}.`;
            clearBtn.hidden = true;
            setEmptyCtaHidden(false);
            announce('No events on this day.');
        }
    }

    function renderUpcoming() {
        const section = document.getElementById('upcomingSection');
        const list = document.getElementById('upcomingList');
        const dateStr = localDateStr(currentDate);

        const upcoming = events
            .filter(e => e.date > dateStr)
            .sort((a, b) => a.date.localeCompare(b.date) || a.time.localeCompare(b.time))
            .slice(0, 5);

        if (upcoming.length === 0) { section.style.display = 'none'; return; }
        section.style.display = '';

        // On an empty day this list is the answer, not a sidebar, so it says so.
        const heading = document.getElementById('upcomingHeading');
        const dayIsEmpty = document.getElementById('emptyState').classList.contains('visible');
        if (heading) heading.textContent = dayIsEmpty ? 'Next up' : 'Coming Up';

        list.innerHTML = '';

        upcoming.forEach(event => {
            const li = document.createElement('li');
            li.className = 'upcoming-item';
            li.setAttribute('role', 'button');
            li.setAttribute('tabindex', '0');

            const d = new Date(event.date + 'T00:00:00');
            const dateLabel = d.toLocaleDateString('en-IE', { weekday: 'short', month: 'short', day: 'numeric' });

            const dateEl = document.createElement('span');
            dateEl.className = 'upcoming-date';
            dateEl.textContent = dateLabel;

            const timeEl = document.createElement('span');
            timeEl.className = 'upcoming-time';
            timeEl.textContent = event.isAllDay ? 'All day' : (event.time || '');

            const titleEl = document.createElement('span');
            titleEl.className = 'upcoming-title';
            titleEl.textContent = event.title;

            const locationEl = document.createElement('span');
            locationEl.className = 'upcoming-location';
            locationEl.textContent = event.location;

            li.append(dateEl, timeEl, titleEl, locationEl);

            const navigate = () => {
                currentDate = new Date(event.date + 'T00:00:00');
                updateDateDisplay();
                renderEvents();
                pushUrlState();
                window.scrollTo({ top: 0, behavior: 'smooth' });
            };
            li.addEventListener('click', navigate);
            li.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); navigate(); } });

            list.appendChild(li);
        });
    }

    // ── JSON-LD Structured Data ─────────────────────────────────────────
    function updateJsonLd(evts) {
        const existing = document.getElementById('jsonld-events');
        if (existing) existing.remove();
        if (!evts.length) return;
        const schema = {
            '@context': 'https://schema.org',
            '@graph': evts.map(e => ({
                '@type': 'Event',
                name: e.title,
                startDate: e.date + (e.isAllDay || !e.time ? '' : 'T' + e.time),
                ...(e.endDate ? { endDate: e.endDate } : {}),
                location: {
                    '@type': 'Place',
                    name: e.location,
                    address: { '@type': 'PostalAddress', addressLocality: 'Naas', addressCountry: 'IE' }
                },
                description: e.description,
                isAccessibleForFree: e.isFree,
                organizer: { '@type': 'Organization', name: 'Naas Today' }
            }))
        };
        const s = document.createElement('script');
        s.type = 'application/ld+json';
        s.id = 'jsonld-events';
        s.textContent = JSON.stringify(schema);
        document.head.appendChild(s);
    }

    // ── Date Navigation ─────────────────────────────────────────────────
    function updateDateDisplay() {
        document.getElementById('currentDateDisplay').textContent = formatDateDisplay(currentDate);
        const isToday = localDateStr(currentDate) === localDateStr(new Date());
        document.getElementById('todayBtn').style.display = isToday ? 'none' : '';
        document.getElementById('prevDay').style.display = isToday ? 'none' : '';
    }

    function changeDate(days) {
        const today = new Date();
        today.setHours(0, 0, 0, 0);
        currentDate.setDate(currentDate.getDate() + days);
        if (currentDate < today) currentDate = today;
        updateDateDisplay();
        renderEvents();
        pushUrlState();
    }

    // ── Focus Trap (for accessible modals) ─────────────────────────────
    let previouslyFocused = null;

    function trapFocus(modal) {
        const focusable = modal.querySelectorAll('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])');
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        modal._trapHandler = function(e) {
            if (e.key !== 'Tab') return;
            if (e.shiftKey) {
                if (document.activeElement === first) { e.preventDefault(); last.focus(); }
            } else {
                if (document.activeElement === last) { e.preventDefault(); first.focus(); }
            }
        };
        modal.addEventListener('keydown', modal._trapHandler);
    }

    // ── Modal Helpers ───────────────────────────────────────────────────
    function openModal(id) {
        previouslyFocused = document.activeElement;
        const modal = document.getElementById(id);
        modal.classList.add('active');
        document.body.classList.add('modal-open');
        const firstFocusable = modal.querySelector('button, [href], input, select, textarea');
        if (firstFocusable) firstFocusable.focus();
        trapFocus(modal);
    }

    function closeModal(id) {
        const modal = document.getElementById(id);
        modal.classList.remove('active');
        document.body.classList.remove('modal-open');
        if (modal._trapHandler) {
            modal.removeEventListener('keydown', modal._trapHandler);
            delete modal._trapHandler;
        }
        if (previouslyFocused) previouslyFocused.focus();
    }

    // ── Event Listeners ─────────────────────────────────────────────────
    window.addEventListener('popstate', () => {
        readUrlState();
        updateDateDisplay();
        renderEvents();
    });

    document.getElementById('prevDay').addEventListener('click', () => changeDate(-1));
    document.getElementById('nextDay').addEventListener('click', () => changeDate(1));

    document.getElementById('todayBtn').addEventListener('click', () => {
        currentDate = new Date();
        updateDateDisplay();
        renderEvents();
        pushUrlState();
    });

    document.getElementById('changeDateBtn').addEventListener('click', () => {
        const dateInput = document.getElementById('dateInput');
        dateInput.min = localDateStr(new Date());
        dateInput.value = localDateStr(currentDate);
        openModal('dateModal');
    });

    document.getElementById('closeDateModal').addEventListener('click', () => closeModal('dateModal'));

    document.getElementById('dateInput').addEventListener('change', (e) => {
        currentDate = new Date(e.target.value + 'T00:00:00');
        updateDateDisplay();
        renderEvents();
        pushUrlState();
        closeModal('dateModal');
    });

    document.getElementById('filterFree').addEventListener('click', function() {
        filterFreeActive = !filterFreeActive;
        this.classList.toggle('active');
        this.setAttribute('aria-pressed', filterFreeActive);
        renderEvents();
        pushUrlState();
    });

    document.getElementById('filterKids').addEventListener('click', function() {
        filterKidsActive = !filterKidsActive;
        this.classList.toggle('active');
        this.setAttribute('aria-pressed', filterKidsActive);
        renderEvents();
        pushUrlState();
    });

    document.getElementById('filterMusic').addEventListener('click', function() {
        filterMusicActive = !filterMusicActive;
        this.classList.toggle('active');
        this.setAttribute('aria-pressed', filterMusicActive);
        renderEvents();
        pushUrlState();
    });

    document.getElementById('filterSport').addEventListener('click', function() {
        filterSportActive = !filterSportActive;
        this.classList.toggle('active');
        this.setAttribute('aria-pressed', filterSportActive);
        renderEvents();
        pushUrlState();
    });

    document.getElementById('filterMarket').addEventListener('click', function() {
        filterMarketActive = !filterMarketActive;
        this.classList.toggle('active');
        this.setAttribute('aria-pressed', filterMarketActive);
        renderEvents();
        pushUrlState();
    });

    document.getElementById('filterTheatre').addEventListener('click', function() {
        filterTheatreActive = !filterTheatreActive;
        this.classList.toggle('active');
        this.setAttribute('aria-pressed', filterTheatreActive);
        renderEvents();
        pushUrlState();
    });

    // Character counter for description
    const descTextarea = document.getElementById('eventDescription');
    const charCounter = document.getElementById('descCharCounter');
    if (descTextarea && charCounter) {
        descTextarea.addEventListener('input', () => {
            charCounter.textContent = `${descTextarea.value.length} / 2000`;
        });
    }

    // Time mode toggle in submit form
    document.querySelectorAll('input[name="timeMode"]').forEach(radio => {
        radio.addEventListener('change', function() {
            const isAllDay = this.value === 'allday';
            const isRange = this.value === 'range';
            const timeInputsEl = document.getElementById('timeInputs');
            const timeEndEl = document.getElementById('eventTimeEnd');
            const timeSepEl = document.getElementById('timeRangeSep');
            const timeStartEl = document.getElementById('eventTimeStart');
            timeInputsEl.style.display = isAllDay ? 'none' : 'flex';
            timeEndEl.style.display = isRange ? '' : 'none';
            timeSepEl.style.display = isRange ? '' : 'none';
            timeStartEl.required = !isAllDay;
        });
    });

    // Reset time mode UI when form resets
    document.getElementById('eventForm').addEventListener('reset', () => {
        setTimeout(() => {
            document.getElementById('timeInputs').style.display = 'flex';
            document.getElementById('eventTimeEnd').style.display = 'none';
            document.getElementById('timeRangeSep').style.display = 'none';
            document.getElementById('eventTimeStart').required = true;
        }, 0);
    });

    // ── Draft persistence ────────────────────────────────────────────────
    //
    // Item 10 stopped a stray Escape wiping the form, but only within one page
    // load. A reload, a crash, or a tab the phone evicted still lost everything.
    // The draft is written on every keystroke and lives until the submission
    // lands or the visitor explicitly cancels. Shape and storage live in
    // src/scripts/draft.js, shared with AppModals.astro's copy of this form.
    const draftFields = () => document.getElementById('eventForm').querySelectorAll('input, textarea, select');

    function restoreDraft() {
        const draft = readDraft();
        if (!draft) return;
        applyDraft(draftFields(), draft);
        // Values alone leave the dependent UI wrong — the recurring section stays
        // hidden, the end-time input stays collapsed, the counter reads 0. Re-fire
        // the events those handlers already listen for rather than repeating them.
        document.getElementById('isRecurring').dispatchEvent(new Event('change'));
        document.querySelector('input[name="timeMode"]:checked').dispatchEvent(new Event('change'));
        document.getElementById('eventDescription').dispatchEvent(new Event('input'));
        updateRecurrenceHint();
    }

    document.getElementById('eventForm').addEventListener('input', () => saveDraft(draftFields()));
    document.getElementById('eventForm').addEventListener('reset', clearDraft);

    // Every submit entry point opens the modal on the day currently being viewed,
    // not on today — unless a draft is waiting, in which case the date the visitor
    // typed outranks the day they happen to be looking at.
    function openSubmitModal() {
        if (!hasDraft()) document.getElementById('eventDate').value = localDateStr(currentDate);
        openModal('submitModal');
    }

    document.getElementById('submitEventBtn').addEventListener('click', openSubmitModal);
    document.getElementById('submitEventFooterBtn').addEventListener('click', openSubmitModal);
    document.getElementById('emptySubmitBtn')?.addEventListener('click', openSubmitModal);
    document.getElementById('retryBtn')?.addEventListener('click', () => fetchEvents());
    document.getElementById('clearFiltersBtn')?.addEventListener('click', clearAllFilters);

    document.getElementById('closeSubmitModal').addEventListener('click', () => closeModal('submitModal'));

    // Cancel is the one deliberate discard, so it is the one place that asks.
    // A native confirm() rather than a styled panel: this is a destructive
    // action, which is what the platform dialog is actually for. (The eight
    // alert() calls item 17 removes are validation and success messaging —
    // a different problem with the same-looking box.)
    document.getElementById('cancelSubmit').addEventListener('click', () => {
        if (hasDraft() && !confirm('Discard this event? What you have typed will be lost.')) return;
        closeModal('submitModal');
        document.getElementById('eventForm').reset();
    });

    // ── Recurring toggle ─────────────────────────────────────────────────
    function updateRecurrenceHint() {
        const startDate = document.getElementById('eventDate').value;
        const endDate   = document.getElementById('recurrenceEndDate').value;
        const freq      = document.getElementById('recurrenceFrequency').value;
        const hint      = document.getElementById('recurrenceHint');
        if (!startDate || !endDate || endDate <= startDate) { hint.textContent = ''; return; }
        let count = 0, cur = new Date(startDate + 'T00:00:00');
        const end = endDate;
        while (count < 104) {
            const s = cur.toISOString().slice(0, 10);
            if (s > end) break;
            count++;
            if (freq === 'weekly')       cur.setDate(cur.getDate() + 7);
            else if (freq === 'fortnightly') cur.setDate(cur.getDate() + 14);
            else cur.setMonth(cur.getMonth() + 1);
        }
        hint.textContent = count > 0 ? `~${count} occurrence${count !== 1 ? 's' : ''}` : '';
    }

    document.getElementById('isRecurring').addEventListener('change', function() {
        const section = document.getElementById('recurringSection');
        section.style.display = this.checked ? '' : 'none';
        document.getElementById('recurrenceEndDate').required = this.checked;
    });

    document.getElementById('recurrenceFrequency').addEventListener('change', updateRecurrenceHint);
    document.getElementById('recurrenceEndDate').addEventListener('change', updateRecurrenceHint);
    document.getElementById('eventDate').addEventListener('change', updateRecurrenceHint);

    // Also hide recurring section on form reset
    document.getElementById('eventForm').addEventListener('reset', () => {
        setTimeout(() => {
            document.getElementById('recurringSection').style.display = 'none';
            document.getElementById('recurrenceEndDate').required = false;
            document.getElementById('recurrenceHint').textContent = '';
        }, 0);
    });

    document.getElementById('eventForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const submitBtn = e.target.querySelector('button[type="submit"]');
        const originalText = submitBtn.textContent;
        submitBtn.textContent = 'Submitting...';
        submitBtn.disabled = true;

        const timeMode = document.querySelector('input[name="timeMode"]:checked').value;
        const baseEvent = {
            title: document.getElementById('eventTitle').value.trim(),
            date: document.getElementById('eventDate').value,
            endDate: document.getElementById('eventEndDate').value || null,
            isAllDay: timeMode === 'allday',
            time: timeMode !== 'allday' ? document.getElementById('eventTimeStart').value : null,
            timeEnd: timeMode === 'range' ? document.getElementById('eventTimeEnd').value : null,
            location: document.getElementById('eventLocation').value.trim(),
            description: document.getElementById('eventDescription').value.trim(),
            isFree: document.getElementById('isFree').checked,
            isForKids: document.getElementById('isForKids').checked,
            isMusic:   document.getElementById('isMusic').checked,
            isSport:   document.getElementById('isSport').checked,
            isMarket:  document.getElementById('isMarket').checked,
            isTheatre: document.getElementById('isTheatre').checked,
            url: document.getElementById('eventUrl').value.trim() || null
        };

        if (baseEvent.endDate && baseEvent.endDate < baseEvent.date) {
            submitBtn.textContent = originalText;
            submitBtn.disabled = false;
            alert('The end date must be on or after the start date.');
            return;
        }

        const isRecurring = document.getElementById('isRecurring').checked;

        if (isRecurring) {
            const recEndDate  = document.getElementById('recurrenceEndDate').value;
            const frequency   = document.getElementById('recurrenceFrequency').value;

            if (!recEndDate || recEndDate <= baseEvent.date) {
                submitBtn.textContent = originalText;
                submitBtn.disabled = false;
                alert('Please set a "Repeat until" date that is after the event start date.');
                return;
            }

            try {
                const response = await fetch('/.netlify/functions/submit-recurring', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        baseEvent,
                        recurrence: { frequency, endDate: recEndDate }
                    })
                });
                const result = await response.json();
                if (!response.ok) throw new Error(result.error || `Submit failed: ${response.status}`);
                closeModal('submitModal');
                document.getElementById('eventForm').reset();
                alert(`Events Submitted!\n\nThanks for your help! Your ${result.count} events have been submitted. They'll appear once approved.\n\nQuestions? Email me at naastoday.tile693@passinbox.com`);
            } catch (error) {
                console.error('Error submitting recurring events:', error);
                alert('Sorry, something went wrong. Please try again or email naastoday.tile693@passinbox.com.');
            } finally {
                submitBtn.textContent = originalText;
                submitBtn.disabled = false;
            }
        } else {
            try {
                const response = await fetch('/.netlify/functions/submit-event', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(baseEvent)
                });
                if (!response.ok) throw new Error(`Submit failed: ${response.status}`);
                closeModal('submitModal');
                document.getElementById('eventForm').reset();
                alert('Event Submitted! 🎉\n\nThanks for your help! I\'ll review your submission and it should appear on the site within a day or two.\n\nQuestions? Email me at naastoday.tile693@passinbox.com');
            } catch (error) {
                console.error('Error submitting event:', error);
                alert('Sorry, something went wrong. Please try again or email naastoday.tile693@passinbox.com.');
            } finally {
                submitBtn.textContent = originalText;
                submitBtn.disabled = false;
            }
        }
    });

    // ── Footer Modals ────────────────────────────────────────────────────
    document.getElementById('aboutBtn').addEventListener('click', () => openModal('aboutModal'));
    document.getElementById('closeAboutModal').addEventListener('click', () => closeModal('aboutModal'));
    document.getElementById('contactBtn').addEventListener('click', () => openModal('contactModal'));
    document.getElementById('closeContactModal').addEventListener('click', () => closeModal('contactModal'));

    // Close modals on background click or Escape key
    //
    // Dismissing deliberately does NOT reset the form. A mistap outside the sheet
    // or a stray Escape used to wipe a submission with no confirm and no undo, on
    // a form that requires a description of up to 2000 characters. The modal only
    // hides, so leaving the fields alone is what lets a half-written event survive
    // an interruption. Cancel and a successful submit still reset it.
    document.querySelectorAll('.modal').forEach(modal => {
        modal.addEventListener('click', (e) => {
            if (e.target === modal) closeModal(modal.id);
        });
    });

    document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        const activeModal = document.querySelector('.modal.active');
        if (activeModal) closeModal(activeModal.id);
    });

    // ── Deep Link ────────────────────────────────────────────────────────
    function handleDeepLink() {
        const params = new URLSearchParams(location.search);
        const eventId = params.get('event');
        if (!eventId) return;

        const target = events.find(e => String(e.id) === String(eventId));
        if (!target) return;

        currentDate = new Date(target.date + 'T00:00:00');
        updateDateDisplay();
        renderEvents();

        const card = document.querySelector(`[data-event-id="${CSS.escape(eventId)}"]`);
        if (!card) return;
        card.scrollIntoView({ behavior: 'smooth', block: 'center' });
        card.classList.add('deep-link-highlight');
        setTimeout(() => card.classList.remove('deep-link-highlight'), 2500);
    }

    // ── Init ─────────────────────────────────────────────────────────────
    readUrlState();
    updateDateDisplay();
    initDescriptionToggles(document.getElementById('eventsGrid'));
    restoreDraft();   // last: it re-fires the change/input handlers registered above
    fetchEvents().then(handleDeepLink);
  </script>
</BaseLayout>
