---
import BaseLayout from '../layouts/BaseLayout.astro';
import Band from '../components/Band.astro';
import WeekStrip from '../components/WeekStrip.astro';
import FilterControls from '../components/FilterControls.astro';
import EventsGrid from '../components/EventsGrid.astro';
import Footer from '../components/Footer.astro';
import DatePickerModal from '../components/modals/DatePickerModal.astro';
import SubmitEventModal from '../components/modals/SubmitEventModal.astro';
import AboutModal from '../components/modals/AboutModal.astro';
import ContactModal from '../components/modals/ContactModal.astro';
import { clockLabel } from '../scripts/date.js';
import { FILTERS_ENABLED } from '../scripts/flags.js';
// Same query get-events.js serves at runtime — see that module for why it is shared.
import { APPROVED_EVENTS_QUERY } from '../../netlify/functions/lib/events-query.js';

const SUPABASE_URL = import.meta.env.SUPABASE_URL;
const SUPABASE_ANON_KEY = import.meta.env.SUPABASE_ANON_KEY;

let initialEvents: any[] = [];
try {
  if (SUPABASE_URL && SUPABASE_ANON_KEY) {
    const res = await fetch(
      `${SUPABASE_URL}${APPROVED_EVENTS_QUERY}`,
      { headers: { apikey: SUPABASE_ANON_KEY, Authorization: `Bearer ${SUPABASE_ANON_KEY}` } }
    );
    if (res.ok) initialEvents = await res.json();
  }
} catch (e) {
  // silently fall back to empty array; client-side fetch will populate
}

// "Today" means today in Naas, not on the build server (Netlify builds in UTC).
// toISOString() would return yesterday's date for any build run between midnight
// and 1am Irish summer time, pre-rendering the wrong day's events and JSON-LD.
// en-CA gives YYYY-MM-DD.
const todayStr = new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Dublin' }).format(new Date());
const todayEvents = initialEvents.filter(e => {
  if (e.end_date) return e.date <= todayStr && e.end_date >= todayStr;
  return e.date === todayStr;
});

// The band names the next real event when today has none, so an empty day ends
// on something to do rather than on the word "nothing". Only read when the day
// is empty, but computed unconditionally — it is one array scan.
const nextEvent = initialEvents.find(e => e.date > todayStr) ?? null;

// "Coming up" is replaced client-side by renderUpcoming(), but the static HTML
// shipped a heading over an empty <ul> before this existed. First paint, no-JS
// visitors and anything slow enough to see the pre-rendered page got a promise
// with nothing under it — on the section that most often holds the only answer,
// since most weekdays in Naas have no events at all.
//
// This mirrors renderUpcoming() rather than improving on it, because the client
// replaces the list on load and any difference would show as a flicker.
const upcomingEvents = initialEvents.filter(e => e.date > todayStr).slice(0, todayEvents.length === 0 ? 5 : 3);

function upcomingDow(dateStr: string): string {
  return new Date(dateStr + 'T00:00:00').toLocaleDateString('en-IE', { weekday: 'short' }).toUpperCase();
}
function upcomingDom(dateStr: string): string {
  return String(new Date(dateStr + 'T00:00:00').getDate());
}

// Same place-not-address treatment the event card uses.
function venueLabel(location: string): string {
  return location.split(',')[0].trim() || location;
}

function upcomingMeta(event: any): string {
  const when = event.is_all_day ? 'All day' : event.time ? clockLabel(event.time) : 'Time TBC';
  return `${when} · ${venueLabel(event.location)}`;
}

// Build JSON-LD for today's events
const jsonLd = todayEvents.length > 0 ? {
  '@context': 'https://schema.org',
  '@graph': todayEvents.map(e => ({
    '@type': 'Event',
    name: e.title,
    startDate: e.date + (e.is_all_day || !e.time ? '' : 'T' + e.time.substring(0, 5)),
    ...(e.end_date ? { endDate: e.end_date } : {}),
    location: {
      '@type': 'Place',
      name: e.location,
      address: { '@type': 'PostalAddress', addressLocality: 'Naas', addressCountry: 'IE' }
    },
    description: e.description,
    isAccessibleForFree: e.is_free,
    organizer: { '@type': 'Organization', name: 'Naas Today' }
  }))
} : undefined;
---

<BaseLayout jsonLd={jsonLd}>
  <a href="#main-content" class="skip-link">Skip to main content</a>
  <Band dateStr={todayStr} todayStr={todayStr} count={todayEvents.length} next={nextEvent} />
  {/* WeekStrip is inside <main> so the skip link lands above the date controls
      rather than past them — the same reason DateNav was moved in before it. */}
  <main id="main-content" role="main">
    <WeekStrip events={initialEvents} todayStr={todayStr} currentStr={todayStr} />
    <div class="container">
    {/* Built, not shown — see src/scripts/flags.js for the measurements and for
        what flipping the flag brings back. */}
    {FILTERS_ENABLED && <FilterControls />}
    <h2 class="visually-hidden" id="eventsListHeading">Today's events</h2>
    <EventsGrid events={initialEvents} todayStr={todayStr} />

    <section
      id="upcomingSection"
      class="upcoming-section"
      aria-labelledby="upcomingHeading"
      style={upcomingEvents.length === 0 ? 'display:none' : undefined}
    >
      <h2 class="upcoming-heading" id="upcomingHeading">Coming up</h2>
      {/* Real links, not buttons. `?date=` is a state this page already reads on
          load, so these work with JS off and can be opened in a new tab; the
          client intercepts them for speed, not for function. That is also why
          renderUpcoming() can rebuild them without wiring a handler per row. */}
      <ul id="upcomingList" class="upcoming-list">
        {upcomingEvents.map(event => (
          <li>
            <a class="upcoming-item" href={`?date=${event.date}`} data-date={event.date}>
              <span class="upcoming-date">
                {upcomingDow(event.date)}
                <span class="upcoming-dom">{upcomingDom(event.date)}</span>
              </span>
              <span class="upcoming-body">
                <span class="upcoming-title">{event.title}</span>
                <span class="upcoming-meta">{upcomingMeta(event)}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <!-- One submit prompt for every state, and it comes last. The visitor's job
         is answered first either way — by the cards, or by what is coming. -->
    <div class="submit-area" id="submitArea">
      <p>Know of something on in Naas?</p>
      <button class="submit-area-btn" id="submitEventBtn">Tell us →</button>
    </div>
    </div>
  </main>
  <Footer datePicker={true} />
  <DatePickerModal />
  <SubmitEventModal />
  <AboutModal />
  <ContactModal />

  <!-- Expose build-time events to client JS -->
  <script define:vars={{ initialEvents }}>
    window.__INITIAL_EVENTS__ = initialEvents;
  </script>

  <script>
    import { initModals, initSubmitForm, openModal, closeModal } from '../scripts/modal-form.js';
    import {
      localDateStr, clockLabel, timeRangeLabel,
      dayAnswer, dayWordFor, nextPhrase, weekAhead,
    } from '../scripts/date.js';
    // Astro compiles the frontmatter and this block separately, so a shared module
    // is the only way one constant governs both the markup and the behaviour.
    // DESCRIPTION_CLAMP is here for exactly that reason: EventCard.astro folds
    // the pre-rendered card and createEventCard() folds the hydrated one, and
    // two hardcoded thresholds is how they drift.
    import { FILTERS_ENABLED, DESCRIPTION_CLAMP } from '../scripts/flags.js';

    // ── Utilities ──────────────────────────────────────────────────────

    // The CSS override cannot reach a scroll asked for in JS, so the two
    // scrolls in this file ask for their behaviour instead of hardcoding it.
    // Read per call, not once: the setting can change while the tab is open.
    const scrollBehavior = () =>
        window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';

    // Decodes HTML entities (e.g. &eacute; → é) safely via a textarea element
    function decodeHTML(str) {
        if (!str) return str;
        const t = document.createElement('textarea');
        t.innerHTML = str;
        return t.value;
    }

    function setupDescriptionToggle(p) {
        if (p.dataset.toggleInit === 'true') return;
        p.dataset.toggleInit = 'true';
        const btn = p.nextElementSibling;
        if (!btn || !btn.classList.contains('desc-toggle-btn')) return;
        p.classList.add('is-truncatable', 'is-collapsed');
        btn.addEventListener('click', () => {
            const collapsed = p.classList.toggle('is-collapsed');
            btn.textContent = collapsed ? 'Read more' : 'Show less';
            btn.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
        });
    }

    function initDescriptionToggles(root) {
        root.querySelectorAll('p.event-description[data-truncatable="true"]').forEach(setupDescriptionToggle);
    }

    // Maps a Supabase row onto the camelCase shape the rest of this file uses.
    // Called for the build-time events and again for whatever get-events returns.
    function toEvent(row, index) {
        return {
            id: row.id || index + 1,
            title: decodeHTML(row.title || ''),
            date: row.date || '',
            endDate: row.end_date || '',
            time: row.time ? row.time.substring(0, 5) : '',
            timeEnd: row.time_end ? row.time_end.substring(0, 5) : '',
            isAllDay: Boolean(row.is_all_day),
            location: decodeHTML(row.location || ''),
            description: decodeHTML(row.description || ''),
            isFree: Boolean(row.is_free),
            isForKids: Boolean(row.is_for_kids),
            isMusic:   Boolean(row.is_music),
            isSport:   Boolean(row.is_sport),
            isMarket:  Boolean(row.is_market),
            isTheatre: Boolean(row.is_theatre),
            url: row.url || ''
        };
    }

    // One definition of "is this event on this day", used by the card list, the
    // week strip counts and the band's answer. They disagreed once already, when
    // only some of them understood a multi-day run.
    const onDay = (e, ds) => (e.endDate ? e.date <= ds && e.endDate >= ds : e.date === ds);

    const venueOf = e => e.location.split(',')[0].trim() || e.location;

    // ── State ───────────────────────────────────────────────────────────
    let events = (window.__INITIAL_EVENTS__ || []).map(toEvent);
    let currentDate = new Date();
    let isError = false;
    let isStale = false;

    // The six category chips, in row order. `active` lives here rather than in
    // six separate `let`s, so the count badges, the toggle handlers, the URL
    // round-trip and the filtering all read one list. `slug` is the URL token.
    const FILTER_CHIPS = [
        { id: 'filterFree',    slug: 'free',     label: 'Free',     match: e => e.isFree,     active: false },
        { id: 'filterKids',    slug: 'kids',     label: 'For kids', match: e => e.isForKids,  active: false },
        { id: 'filterMusic',   slug: 'music',    label: 'Music',    match: e => e.isMusic,    active: false },
        { id: 'filterSport',   slug: 'sport',    label: 'Sport',    match: e => e.isSport,    active: false },
        { id: 'filterMarket',  slug: 'markets',  label: 'Markets',  match: e => e.isMarket,   active: false },
        { id: 'filterTheatre', slug: 'theatre',  label: 'Theatre',  match: e => e.isTheatre,  active: false },
    ];

    function writeUrlState({ replace = false } = {}) {
        const params = new URLSearchParams();
        const todayStr = localDateStr(new Date());
        const dateStr = localDateStr(currentDate);
        if (dateStr !== todayStr) params.set('date', dateStr);
        if (FILTERS_ENABLED) {
            const activeFilters = FILTER_CHIPS.filter(c => c.active).map(c => c.slug);
            if (activeFilters.length) params.set('filters', activeFilters.join(','));
        }
        // Preserve ?event= only while it still points at something. handleDeepLink
        // clears it on a miss, so a link to a deleted or rejected event stops
        // riding along on every subsequent date change.
        const eventParam = new URLSearchParams(location.search).get('event');
        if (eventParam) params.set('event', eventParam);
        const qs = params.toString();
        history[replace ? 'replaceState' : 'pushState'](null, '', qs ? '?' + qs : location.pathname);
    }

    function readUrlState() {
        const params = new URLSearchParams(location.search);
        const dateParam = params.get('date');
        if (dateParam && /^\d{4}-\d{2}-\d{2}$/.test(dateParam)) {
            const d = new Date(dateParam + 'T00:00:00');
            if (!isNaN(d.getTime())) currentDate = d;
        }
        // Ignored while the chips are not rendered. Honouring an old ?filters= link
        // would drop the visitor into a filtered day with no visible control to
        // undo it — a worse outcome than showing them the whole day.
        if (!FILTERS_ENABLED) return;
        const filtersParam = params.get('filters');
        if (filtersParam) {
            const active = new Set(filtersParam.split(','));
            FILTER_CHIPS.forEach(c => { c.active = active.has(c.slug); });
            syncFilterButtons();
        }
    }

    // Pushes the six filter flags back onto their buttons. Shared by readUrlState
    // and the empty state's "Show all events" escape.
    function syncFilterButtons() {
        if (!FILTERS_ENABLED) return;
        FILTER_CHIPS.forEach(({ id, active }) => {
            const btn = document.getElementById(id);
            if (!btn) return;
            btn.classList.toggle('active', active);
            btn.setAttribute('aria-pressed', String(active));
        });
    }

    function clearAllFilters() {
        FILTER_CHIPS.forEach(c => { c.active = false; });
        syncFilterButtons();
        renderEvents();
        writeUrlState({ replace: true });
    }

    // ── Loading State ───────────────────────────────────────────────────
    function showLoading() {
        document.getElementById('eventsGrid').style.display = 'none';
        document.getElementById('emptyState').classList.remove('visible');
        document.getElementById('loadingState').classList.add('visible');
    }

    function hideLoading() {
        document.getElementById('loadingState').classList.remove('visible');
    }

    // ── Data Fetching ───────────────────────────────────────────────────
    async function fetchEvents() {
        // Only show loading spinner if no pre-rendered content is visible
        if (events.length === 0) showLoading();
        isError = false;
        isStale = false;
        try {
            const response = await fetch('/.netlify/functions/get-events');
            if (!response.ok) throw new Error(`Failed to fetch: ${response.status}`);
            const data = await response.json();
            if (Array.isArray(data) && data.length > 0) {
                events = data.map(toEvent);
            }
        } catch (error) {
            console.error('Error fetching events:', error);
            // Only show error state if we have no pre-rendered events
            if (events.length === 0) {
                isError = true;
            } else {
                // We have pre-rendered events, so the page still works — but they
                // came from the last build, and rebuilds are capped at 15/month.
                // "Nothing on today" and "nobody has touched this in a week" look
                // identical otherwise, on a product whose pitch is that it is
                // moderated and therefore current.
                isStale = true;
            }
        }
        populateLocationSuggestions();
        renderEvents();
    }

    function populateLocationSuggestions() {
        const dl = document.getElementById('location-suggestions');
        if (!dl) return;
        const locations = [...new Set(events.map(e => e.location).filter(Boolean))].sort();
        dl.replaceChildren(...locations.map(loc => {
            const opt = document.createElement('option');
            opt.value = loc;
            return opt;
        }));
    }

    // ── Rendering ───────────────────────────────────────────────────────
    function longDateLabel(date) {
        // Must match Band.astro's own call exactly, or the date rewrites itself
        // under the reader when this script takes over.
        return date.toLocaleDateString('en-IE', { weekday: 'long', day: 'numeric', month: 'long' });
    }

    function formatEventTime(event) {
        if (event.isAllDay) return 'All day';
        if (!event.time) return '';
        return timeRangeLabel(event.time, event.timeEnd);
    }

    function formatDateForShare(dateStr) {
        const d = new Date(dateStr + 'T00:00:00');
        return d.toLocaleDateString('en-IE', { weekday: 'long', day: 'numeric', month: 'long' });
    }

    function shareEvent(event, btn) {
        const timeStr = formatEventTime(event);
        const dateDisplay = formatDateForShare(event.date);
        const when = timeStr ? `${dateDisplay} · ${timeStr}` : dateDisplay;
        const text = `${event.title}\n${when}\n${event.location}`;
        const url = `${location.origin}${location.pathname}?event=${event.id}`;
        if (navigator.share) {
            navigator.share({ title: event.title, text, url }).catch(() => {});
            return;
        }
        // Desktop has no share sheet. It used to get a WhatsApp popup with no
        // warning, which a popup blocker eats silently — the button then did
        // nothing at all, with nothing on screen to say so. Copy the link
        // instead: it is what a desktop visitor was going to do anyway.
        copyLink(btn, `${text}\n\n${url}`);
    }

    // Confirms in the button itself. A toast would need a whole toast system for
    // one message, and the button is where the visitor is already looking.
    async function copyLink(btn, payload) {
        const original = btn ? [...btn.childNodes] : null;
        try {
            await navigator.clipboard.writeText(payload);
            if (btn) btn.replaceChildren('Copied');
            announce('Link copied.');
        } catch {
            // Denied clipboard permission, or a non-secure origin.
            window.prompt('Copy this link:', payload);
        }
        if (btn) setTimeout(() => btn.replaceChildren(...original), 2000);
    }

    function formatDateShort(dateStr) {
        const d = new Date(dateStr + 'T00:00:00');
        return d.toLocaleDateString('en-IE', { day: 'numeric', month: 'short' });
    }

    // The card's first line. Mirrors EventCard.astro's `when`; every case
    // resolves to a string so the slot is never empty.
    function whenLabel(event) {
        const span = event.endDate && event.endDate !== event.date
            ? `${formatDateShort(event.date)} – ${formatDateShort(event.endDate)}`
            : '';
        const clock = event.time ? timeRangeLabel(event.time, event.timeEnd) : '';
        if (event.isAllDay) return span ? `${span} · All day` : 'All day';
        if (span) return clock ? `${span} · ${clock}` : span;
        return clock || 'Time TBC';
    }

    // Builds an event card using DOM methods (avoids XSS from raw data)
    function createEventCard(event) {
        const card = document.createElement('article');
        card.className = 'event-card';
        card.dataset.eventId = event.id;
        card.setAttribute('aria-labelledby', 'event-title-' + event.id);

        const when = document.createElement('div');
        when.className = 'ev-when';
        when.textContent = whenLabel(event);
        card.appendChild(when);

        const title = document.createElement('h3');
        title.className = 'event-title';
        title.id = 'event-title-' + event.id;
        title.textContent = event.title;
        card.appendChild(title);

        // Venue and source share one 44px row — see EventCard.astro for why.
        const meta = document.createElement('div');
        meta.className = 'ev-meta';

        const loc = document.createElement('a');
        loc.className = 'event-location';
        loc.href = `https://maps.google.com/?q=${encodeURIComponent(event.location + ', Naas, Ireland')}`;
        loc.target = '_blank';
        loc.rel = 'noopener noreferrer';
        // Must match EventCard.astro's `venue` — the pre-rendered card and this one
        // sit in the same list and any difference shows as a flicker on hydration.
        loc.title = event.location;
        loc.textContent = venueOf(event);
        meta.appendChild(loc);

        if (event.url) {
            try {
                const parsed = new URL(event.url);
                if (['http:', 'https:'].includes(parsed.protocol)) {
                    const urlEl = document.createElement('a');
                    urlEl.className = 'event-url';
                    urlEl.href = parsed.href;
                    urlEl.target = '_blank';
                    urlEl.rel = 'noopener noreferrer';
                    urlEl.textContent = parsed.hostname.replace(/^www\./, '');
                    meta.appendChild(urlEl);
                }
            } catch {
                // Invalid URL — skip
            }
        }
        // Share is a text action on this row now, not a bordered box in the
        // card's corner — see EventCard.astro.
        const shareBtn = document.createElement('button');
        shareBtn.className = 'share-btn';
        shareBtn.textContent = 'Share';
        shareBtn.setAttribute('aria-label', `Share ${event.title}`);
        shareBtn.addEventListener('click', () => shareEvent(event, shareBtn));
        meta.appendChild(shareBtn);

        card.appendChild(meta);

        const descText = event.description || '';
        const isLong = descText.length > DESCRIPTION_CLAMP;
        if (descText) {
            const desc = document.createElement('p');
            desc.className = 'event-description';
            desc.textContent = descText;
            if (isLong) {
                desc.dataset.truncatable = 'true';
                desc.style.marginBottom = '0';
            }
            card.appendChild(desc);
        }
        if (isLong) {
            const toggleBtn = document.createElement('button');
            toggleBtn.className = 'desc-toggle-btn';
            toggleBtn.type = 'button';
            toggleBtn.textContent = 'Read more';
            toggleBtn.setAttribute('aria-expanded', 'false');
            card.appendChild(toggleBtn);
        }

        const footer = document.createElement('div');
        footer.className = 'card-footer';

        const tags = document.createElement('div');
        tags.className = 'event-tags';
        const tagDefs = [
            [event.isFree,     'Free'],
            [event.isForKids,  'For kids'],
            [event.isMusic,    'Music'],
            [event.isSport,    'Sport'],
            [event.isMarket,   'Market'],
            [event.isTheatre,  'Theatre'],
        ];
        tagDefs.forEach(([flag, label]) => {
            if (flag) {
                const tag = document.createElement('span');
                tag.className = 'tag';
                tag.textContent = label;
                tags.appendChild(tag);
            }
        });
        footer.appendChild(tags);

        card.appendChild(footer);
        return card;
    }

    // ── The band ────────────────────────────────────────────────────────
    // The day's answer and the band's own size, which is a function of it. The
    // sentence is built by the same helper Band.astro uses, so hydration does
    // not rewrite the largest words on the page.
    function renderBand(dayCount) {
        const dateStr = localDateStr(currentDate);
        const todayStr = localDateStr(new Date());
        const band = document.querySelector('.band');
        const answerEl = document.getElementById('dayAnswer');
        if (answerEl) answerEl.textContent = dayAnswer(dayCount, dayWordFor(dateStr, todayStr));
        if (band) {
            band.classList.remove('is-xl', 'is-lg', 'is-sm');
            band.classList.add(dayCount === 0 ? 'is-xl' : dayCount === 1 ? 'is-lg' : 'is-sm');
        }

        // "Next in Naas" belongs to the empty day only. On a day with events the
        // cards are the answer and this would be a second one.
        const next = dayCount === 0
            ? events.filter(e => e.date > dateStr)
                    .sort((a, b) => a.date.localeCompare(b.date) || (a.time || '').localeCompare(b.time || ''))[0]
            : null;
        const link = document.getElementById('bandNext');
        if (!link) return;
        if (!next) { link.hidden = true; return; }
        link.hidden = false;
        link.href = `?date=${next.date}`;
        link.dataset.date = next.date;
        document.getElementById('bandNextWhen').textContent = nextPhrase(next, dateStr);
        document.getElementById('bandNextTitle').textContent = next.title;
        document.getElementById('bandNextVenue').textContent = venueOf(next);
    }

    // ── The week strip ──────────────────────────────────────────────────
    // Seven days from today, always. It is the whole of the date navigation, and
    // it deliberately stops at a week: anything further out is the footer's date
    // picker, which is the rarer visit.
    function renderWeekStrip() {
        const list = document.querySelector('.weekstrip-r');
        if (!list) return;
        const todayStr = localDateStr(new Date());
        const currentStr = localDateStr(currentDate);

        list.replaceChildren(...weekAhead(todayStr).map(ds => {
            const d = new Date(ds + 'T00:00:00');
            const n = events.filter(e => onDay(e, ds)).length;

            const li = document.createElement('li');
            const a = document.createElement('a');
            a.className = 'weekstrip-d' + (ds === currentStr ? ' is-current' : '') + (ds === todayStr ? ' is-today' : '');
            a.href = ds === todayStr ? '/' : `?date=${ds}`;
            a.dataset.date = ds;
            if (ds === currentStr) a.setAttribute('aria-current', 'date');
            const long = d.toLocaleDateString('en-IE', { weekday: 'long', day: 'numeric', month: 'long' });
            a.setAttribute('aria-label', `${long} — ${n === 0 ? 'nothing on' : n === 1 ? '1 event' : `${n} events`}`);

            const day = document.createElement('span');
            day.className = 'weekstrip-day';
            day.setAttribute('aria-hidden', 'true');
            day.textContent = d.toLocaleDateString('en-IE', { weekday: 'short' })[0];

            const count = document.createElement('span');
            count.className = 'weekstrip-n' + (n === 0 ? ' is-nil' : '');
            count.setAttribute('aria-hidden', 'true');
            count.textContent = n === 0 ? '–' : String(n);

            a.append(day, count);
            li.appendChild(a);
            return li;
        }));
    }

    function renderEvents() {
        hideLoading();
        const grid = document.getElementById('eventsGrid');
        const emptyState = document.getElementById('emptyState');
        const errorState = document.getElementById('errorState');
        // The one place the CTA still hides: the error state carries its own
        // Try again button, and two stacked actions is worse than one.
        const submitArea = document.getElementById('submitArea');
        const dateStr = localDateStr(currentDate);

        if (isError) {
            grid.style.display = 'none';
            emptyState.classList.remove('visible');
            errorState.classList.add('visible');
            if (submitArea) submitArea.style.display = 'none';
            // Nothing loaded, so the band cannot claim a count either way.
            const answerEl = document.getElementById('dayAnswer');
            if (answerEl) answerEl.textContent = '';
            const bandNext = document.getElementById('bandNext');
            if (bandNext) bandNext.hidden = true;
            updateJsonLd([]);
            renderUpcoming();
            renderWeekStrip();
            announce('Could not load events.');
            return;
        }
        errorState.classList.remove('visible');
        if (submitArea) submitArea.style.display = '';

        const staleNote = document.getElementById('staleNote');
        if (staleNote) staleNote.hidden = !isStale;

        let filteredEvents = events.filter(e => onDay(e, dateStr));

        // Held before the category filters are applied, so an empty result can tell
        // "nothing is on today" from "your filters hid everything". Only one of those
        // is the visitor's to fix, and saying the wrong one reads as a broken site.
        const dayEvents = filteredEvents;
        // Counts the day, not the filtered result: the band answers "is anything
        // on?", which a filter does not change.
        renderBand(dayEvents.length);
        renderWeekStrip();

        // Count badges. Every chip shows its count, zero included. Counts are
        // taken before the category filters are applied, so they always mean
        // "events today with this tag", not "…that also survive your other
        // chips". A chip can therefore be both .active and .is-empty.
        if (FILTERS_ENABLED) {
            FILTER_CHIPS.forEach(({ id, label, match }) => {
                const count = filteredEvents.filter(match).length;
                const btn = document.getElementById(id);
                if (!btn) return;
                btn.querySelector('span').textContent = `${label} (${count})`;
                btn.classList.toggle('is-empty', count === 0);
            });
        }

        // AND across the active chips, as before: an event must match every one.
        for (const chip of FILTER_CHIPS) {
            if (chip.active) filteredEvents = filteredEvents.filter(chip.match);
        }

        if (filteredEvents.length === 0) {
            grid.style.display = 'none';
            // A genuinely empty day is already answered by the band, at display
            // size, with the next real event under it. Only a day emptied *by
            // filters* needs a panel — that is a different sentence and it needs
            // an escape hatch.
            emptyState.classList.toggle('visible', dayEvents.length > 0);
            setEmptyState(dayEvents.length);
            updateJsonLd([]);
            renderUpcoming();
            return;
        }

        grid.style.display = 'grid';
        emptyState.classList.remove('visible');
        filteredEvents.sort((a, b) => a.time.localeCompare(b.time));
        grid.innerHTML = '';
        filteredEvents.forEach(event => grid.appendChild(createEventCard(event)));
        initDescriptionToggles(grid);
        updateJsonLd(filteredEvents);
        renderUpcoming();
        announce(`${filteredEvents.length} ${filteredEvents.length === 1 ? 'event' : 'events'}.`);
    }

    // Announces the outcome as a short count. The live region used to wrap the whole
    // list, so every filter tap re-read each card in full, descriptions included.
    function announce(text) {
        const status = document.getElementById('eventsStatus');
        if (status) status.textContent = text;
    }

    // Only reached with events hidden behind filters, or with none at all. The
    // second case renders nothing — the band said it — but still announces, so a
    // screen reader is told the day is empty rather than left in silence.
    function setEmptyState(dayCount) {
        const heading  = document.getElementById('emptyHeading');
        const message  = document.getElementById('emptyMessage');
        const clearBtn = document.getElementById('clearFiltersBtn');

        if (dayCount === 0) {
            clearBtn.hidden = true;
            announce('No events on this day.');
            return;
        }

        const activeCount = FILTER_CHIPS.filter(c => c.active).length;
        // "today" is only true on the day itself; the visitor can be three taps
        // into next week.
        const isToday = localDateStr(currentDate) === localDateStr(new Date());
        const dayPhrase = isToday ? 'today' : 'on this day';
        heading.textContent = 'No matching events';
        // Filters AND together and nothing said so, which is why "Free + For
        // kids" returning nothing read as "there is nothing on" rather than "no
        // one event is both". Only worth saying with two or more lit.
        const andNote = activeCount > 1
            ? ' An event has to match every filter you have on — try turning one off.'
            : '';
        message.textContent = (dayCount === 1
            ? `There is 1 other event ${dayPhrase}.`
            : `There are ${dayCount} other events ${dayPhrase}.`) + andNote;
        clearBtn.hidden = false;
        announce(`No matching events. ${dayCount} ${dayCount === 1 ? 'event' : 'events'} hidden by filters.`);
    }

    function renderUpcoming() {
        const section = document.getElementById('upcomingSection');
        const list = document.getElementById('upcomingList');
        const dateStr = localDateStr(currentDate);
        const dayCount = events.filter(e => onDay(e, dateStr)).length;

        // Five on a day with nothing on, where this list is most of the page;
        // three when there are cards above it and it is a footnote to them.
        const upcoming = events
            .filter(e => e.date > dateStr)
            .sort((a, b) => a.date.localeCompare(b.date) || a.time.localeCompare(b.time))
            .slice(0, dayCount === 0 ? 5 : 3);

        if (upcoming.length === 0) { section.style.display = 'none'; return; }
        section.style.display = '';

        list.replaceChildren(...upcoming.map(event => {
            const d = new Date(event.date + 'T00:00:00');
            const li = document.createElement('li');

            // A real link, so it survives with JS off and can be opened in a new
            // tab. The delegated handler below intercepts it for speed.
            const a = document.createElement('a');
            a.className = 'upcoming-item';
            a.href = `?date=${event.date}`;
            a.dataset.date = event.date;

            const dateEl = document.createElement('span');
            dateEl.className = 'upcoming-date';
            dateEl.textContent = d.toLocaleDateString('en-IE', { weekday: 'short' }).toUpperCase();
            const dom = document.createElement('span');
            dom.className = 'upcoming-dom';
            dom.textContent = String(d.getDate());
            dateEl.appendChild(dom);

            const body = document.createElement('span');
            body.className = 'upcoming-body';

            const titleEl = document.createElement('span');
            titleEl.className = 'upcoming-title';
            titleEl.textContent = event.title;

            const metaEl = document.createElement('span');
            metaEl.className = 'upcoming-meta';
            const when = event.isAllDay ? 'All day' : event.time ? clockLabel(event.time) : 'Time TBC';
            metaEl.textContent = `${when} · ${venueOf(event)}`;

            body.append(titleEl, metaEl);
            a.append(dateEl, body);
            li.appendChild(a);
            return li;
        }));
    }

    // ── JSON-LD Structured Data ─────────────────────────────────────────
    function updateJsonLd(evts) {
        const existing = document.getElementById('jsonld-events');
        if (existing) existing.remove();
        if (!evts.length) return;
        const schema = {
            '@context': 'https://schema.org',
            '@graph': evts.map(e => ({
                '@type': 'Event',
                name: e.title,
                startDate: e.date + (e.isAllDay || !e.time ? '' : 'T' + e.time),
                ...(e.endDate ? { endDate: e.endDate } : {}),
                location: {
                    '@type': 'Place',
                    name: e.location,
                    address: { '@type': 'PostalAddress', addressLocality: 'Naas', addressCountry: 'IE' }
                },
                description: e.description,
                isAccessibleForFree: e.isFree,
                organizer: { '@type': 'Organization', name: 'Naas Today' }
            }))
        };
        const s = document.createElement('script');
        s.type = 'application/ld+json';
        s.id = 'jsonld-events';
        s.textContent = JSON.stringify(schema);
        document.head.appendChild(s);
    }

    // ── Date Navigation ─────────────────────────────────────────────────
    function updateDateDisplay() {
        const el = document.getElementById('currentDateDisplay');
        if (el) el.textContent = longDateLabel(currentDate);
        // Built from the date rather than reusing the band's sentence, whose
        // "today" reads badly inside a heading.
        document.getElementById('eventsListHeading').textContent =
            'Events on ' + currentDate.toLocaleDateString('en-IE', { weekday: 'long', day: 'numeric', month: 'long' });
    }

    function goToDate(dateStr, { scroll = true } = {}) {
        currentDate = new Date(dateStr + 'T00:00:00');
        updateDateDisplay();
        renderEvents();
        writeUrlState();
        if (scroll) window.scrollTo({ top: 0, behavior: scrollBehavior() });
    }

    // One delegated handler for every date link on the page — the week strip,
    // the band's "Next in Naas" and the Coming up rows. They are real anchors to
    // ?date=, which already works on load, so this only saves the reload.
    // Modified clicks fall through, or cmd-click would stop opening a new tab.
    document.addEventListener('click', (e) => {
        if (e.defaultPrevented || e.button !== 0) return;
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        const link = e.target.closest('a[data-date]');
        if (!link) return;
        e.preventDefault();
        goToDate(link.dataset.date);
    });

    // ── Event Listeners ─────────────────────────────────────────────────
    window.addEventListener('popstate', () => {
        // Back must be able to return to today, so the date is reset before the
        // URL is re-read rather than left at wherever the visitor had got to.
        currentDate = new Date();
        readUrlState();
        updateDateDisplay();
        renderEvents();
    });

    document.getElementById('changeDateBtn')?.addEventListener('click', () => {
        const dateInput = document.getElementById('dateInput');
        dateInput.min = localDateStr(new Date());
        dateInput.value = localDateStr(currentDate);
        openModal('dateModal');
    });

    document.getElementById('closeDateModal').addEventListener('click', () => closeModal('dateModal'));

    document.getElementById('dateInput').addEventListener('change', (e) => {
        goToDate(e.target.value, { scroll: false });
        closeModal('dateModal');
    });

    if (FILTERS_ENABLED) FILTER_CHIPS.forEach(chip => {
        document.getElementById(chip.id).addEventListener('click', function() {
            chip.active = !chip.active;
            this.classList.toggle('active', chip.active);
            this.setAttribute('aria-pressed', String(chip.active));
            renderEvents();
            // Replace, not push. Filtering is refining the current view, not
            // navigating to a new one — three taps while browsing used to mean
            // Back no longer left the site, which is not what Back is for.
            // Date changes still push: those are navigation.
            writeUrlState({ replace: true });
        });
    });

    document.getElementById('retryBtn')?.addEventListener('click', () => fetchEvents());
    document.getElementById('clearFiltersBtn')?.addEventListener('click', clearAllFilters);

    // ── Deep Link ────────────────────────────────────────────────────────
    // Drops ?event= when it resolves to nothing, so a stale link does not survive
    // every later navigation. Uses replaceState: the visitor did not navigate,
    // and a bad param should not cost them a Back press to escape.
    function dropEventParam() {
        const params = new URLSearchParams(location.search);
        if (!params.has('event')) return;
        params.delete('event');
        const qs = params.toString();
        history.replaceState(null, '', qs ? '?' + qs : location.pathname);
    }

    function handleDeepLink() {
        const params = new URLSearchParams(location.search);
        const eventId = params.get('event');
        if (!eventId) return;

        const target = events.find(e => String(e.id) === String(eventId));
        if (!target) { dropEventParam(); return; }

        currentDate = new Date(target.date + 'T00:00:00');
        updateDateDisplay();
        renderEvents();

        const card = document.querySelector(`[data-event-id="${CSS.escape(eventId)}"]`);
        if (!card) return;
        card.scrollIntoView({ behavior: scrollBehavior(), block: 'center' });
        card.classList.add('deep-link-highlight');
        setTimeout(() => card.classList.remove('deep-link-highlight'), 2500);
    }

    // ── Init ─────────────────────────────────────────────────────────────
    readUrlState();
    updateDateDisplay();
    // Paint the requested day from the build-time events before going to the
    // network. The pre-rendered HTML is always *today*, so following a ?date=
    // link — the week strip and every Coming up row are real links to one —
    // used to show Saturday's date over Monday's answer, Monday's strip marker
    // and Monday's cards until get-events came back. Everything needed to render
    // Saturday was already in memory; only the fetch was being waited on.
    if (events.length) renderEvents();
    initDescriptionToggles(document.getElementById('eventsGrid'));
    initModals();
    // The submit modal opens on the day being viewed, not on today — a visitor
    // three taps into next week is almost certainly adding an event for then.
    // initSubmitForm restores any waiting draft, so it goes last: doing that
    // re-fires the change/input handlers it has just registered.
    initSubmitForm({ defaultDate: () => localDateStr(currentDate) });
    fetchEvents().then(handleDeepLink);
  </script>
</BaseLayout>
