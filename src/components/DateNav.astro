---
<div class="date-section">
    <div class="container">
        <div class="date-header">
            <div class="current-date" id="currentDateDisplay">Today</div>
            <nav class="date-nav" aria-label="Date navigation">
                <button class="date-nav-btn" id="prevDay" aria-label="Previous day" style="display:none">← Previous</button>
                <button class="date-nav-btn today-btn" id="todayBtn" style="display:none">Today</button>
                <button class="date-nav-btn" id="changeDateBtn">Change date</button>
                <button class="date-nav-btn" id="nextDay" aria-label="Next day">Next →</button>
            </nav>
        </div>
    </div>
</div>
