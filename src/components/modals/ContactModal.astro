<div class="modal" id="contactModal" role="dialog" aria-modal="true" aria-labelledby="contactModalTitle">
    <div class="modal-content">
        <div class="modal-header">
            <h2 id="contactModalTitle">Contact</h2>
            <button class="modal-close" id="closeContactModal" aria-label="Close">✕</button>
        </div>
        <div class="modal-body">
            <p style="margin-bottom: 0;">To get in touch: <a href="mailto:hello@naastoday.com" style="color: var(--accent);">hello@naastoday.com</a><br>Every message is read and appreciated!</p>
        </div>
    </div>
</div>
