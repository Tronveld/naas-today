---
import AboutModal from './modals/AboutModal.astro';
import ContactModal from './modals/ContactModal.astro';
import SubmitEventModal from './modals/SubmitEventModal.astro';
---
<AboutModal />
<ContactModal />
<SubmitEventModal />

<script>
    function localDateStr(date: Date): string {
        const y = date.getFullYear();
        const m = String(date.getMonth() + 1).padStart(2, '0');
        const d = String(date.getDate()).padStart(2, '0');
        return `${y}-${m}-${d}`;
    }

    let previouslyFocused: Element | null = null;

    function trapFocus(modal: HTMLElement) {
        const focusable = modal.querySelectorAll<HTMLElement>('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])');
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        (modal as any)._trapHandler = function(e: KeyboardEvent) {
            if (e.key !== 'Tab') return;
            if (e.shiftKey) {
                if (document.activeElement === first) { e.preventDefault(); last.focus(); }
            } else {
                if (document.activeElement === last) { e.preventDefault(); first.focus(); }
            }
        };
        modal.addEventListener('keydown', (modal as any)._trapHandler);
    }

    function openModal(id: string) {
        previouslyFocused = document.activeElement;
        const modal = document.getElementById(id) as HTMLElement;
        modal.classList.add('active');
        const firstFocusable = modal.querySelector<HTMLElement>('button, [href], input, select, textarea');
        if (firstFocusable) firstFocusable.focus();
        trapFocus(modal);
    }

    function closeModal(id: string) {
        const modal = document.getElementById(id) as HTMLElement;
        modal.classList.remove('active');
        if ((modal as any)._trapHandler) {
            modal.removeEventListener('keydown', (modal as any)._trapHandler);
            delete (modal as any)._trapHandler;
        }
        if (previouslyFocused && 'focus' in previouslyFocused) (previouslyFocused as HTMLElement).focus();
    }

    // About
    document.getElementById('aboutBtn')?.addEventListener('click', () => openModal('aboutModal'));
    document.getElementById('closeAboutModal')?.addEventListener('click', () => closeModal('aboutModal'));

    // Contact
    document.getElementById('contactBtn')?.addEventListener('click', () => openModal('contactModal'));
    document.getElementById('closeContactModal')?.addEventListener('click', () => closeModal('contactModal'));

    // Submit Event footer button
    document.getElementById('submitEventFooterBtn')?.addEventListener('click', () => {
        const dateInput = document.getElementById('eventDate') as HTMLInputElement;
        if (dateInput) dateInput.value = localDateStr(new Date());
        openModal('submitModal');
    });

    document.getElementById('closeSubmitModal')?.addEventListener('click', () => closeModal('submitModal'));
    document.getElementById('cancelSubmit')?.addEventListener('click', () => {
        closeModal('submitModal');
        (document.getElementById('eventForm') as HTMLFormElement)?.reset();
    });

    // Time mode toggle
    document.querySelectorAll<HTMLInputElement>('input[name="timeMode"]').forEach(radio => {
        radio.addEventListener('change', function() {
            const isAllDay = this.value === 'allday';
            const isRange = this.value === 'range';
            const timeInputsEl = document.getElementById('timeInputs') as HTMLElement;
            const timeEndEl = document.getElementById('eventTimeEnd') as HTMLElement;
            const timeSepEl = document.getElementById('timeRangeSep') as HTMLElement;
            const timeStartEl = document.getElementById('eventTimeStart') as HTMLInputElement;
            timeInputsEl.style.display = isAllDay ? 'none' : 'flex';
            timeEndEl.style.display = isRange ? '' : 'none';
            timeSepEl.style.display = isRange ? '' : 'none';
            timeStartEl.required = !isAllDay;
        });
    });

    // Reset time mode UI
    document.getElementById('eventForm')?.addEventListener('reset', () => {
        setTimeout(() => {
            (document.getElementById('timeInputs') as HTMLElement).style.display = 'flex';
            (document.getElementById('eventTimeEnd') as HTMLElement).style.display = 'none';
            (document.getElementById('timeRangeSep') as HTMLElement).style.display = 'none';
            (document.getElementById('eventTimeStart') as HTMLInputElement).required = true;
        }, 0);
    });

    // Recurring toggle
    function updateRecurrenceHint() {
        const startDate = (document.getElementById('eventDate') as HTMLInputElement).value;
        const endDate   = (document.getElementById('recurrenceEndDate') as HTMLInputElement).value;
        const freq      = (document.getElementById('recurrenceFrequency') as HTMLSelectElement).value;
        const hint      = document.getElementById('recurrenceHint') as HTMLElement;
        if (!startDate || !endDate || endDate <= startDate) { hint.textContent = ''; return; }
        let count = 0, cur = new Date(startDate + 'T00:00:00');
        while (count < 104) {
            const s = cur.toISOString().slice(0, 10);
            if (s > endDate) break;
            count++;
            if (freq === 'weekly')           cur.setDate(cur.getDate() + 7);
            else if (freq === 'fortnightly') cur.setDate(cur.getDate() + 14);
            else                             cur.setMonth(cur.getMonth() + 1);
        }
        hint.textContent = count > 0 ? `~${count} occurrence${count !== 1 ? 's' : ''}` : '';
    }

    document.getElementById('isRecurring')?.addEventListener('change', function(this: HTMLInputElement) {
        const section = document.getElementById('recurringSection') as HTMLElement;
        section.style.display = this.checked ? '' : 'none';
        (document.getElementById('recurrenceEndDate') as HTMLInputElement).required = this.checked;
    });

    document.getElementById('recurrenceFrequency')?.addEventListener('change', updateRecurrenceHint);
    document.getElementById('recurrenceEndDate')?.addEventListener('change', updateRecurrenceHint);
    document.getElementById('eventDate')?.addEventListener('change', updateRecurrenceHint);

    document.getElementById('eventForm')?.addEventListener('reset', () => {
        setTimeout(() => {
            (document.getElementById('recurringSection') as HTMLElement).style.display = 'none';
            (document.getElementById('recurrenceEndDate') as HTMLInputElement).required = false;
            (document.getElementById('recurrenceHint') as HTMLElement).textContent = '';
        }, 0);
    });

    // Character counter
    const descTextarea = document.getElementById('eventDescription') as HTMLTextAreaElement;
    const charCounter = document.getElementById('descCharCounter') as HTMLElement;
    if (descTextarea && charCounter) {
        descTextarea.addEventListener('input', () => {
            charCounter.textContent = `${descTextarea.value.length} / 2000`;
        });
    }

    // Form submission
    document.getElementById('eventForm')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const form = e.target as HTMLFormElement;
        const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
        const originalText = submitBtn.textContent!;
        submitBtn.textContent = 'Submitting...';
        submitBtn.disabled = true;

        const timeMode = (document.querySelector<HTMLInputElement>('input[name="timeMode"]:checked'))!.value;
        const baseEvent = {
            title:       (document.getElementById('eventTitle') as HTMLInputElement).value.trim(),
            date:        (document.getElementById('eventDate') as HTMLInputElement).value,
            endDate:     (document.getElementById('eventEndDate') as HTMLInputElement).value || null,
            isAllDay:    timeMode === 'allday',
            time:        timeMode !== 'allday' ? (document.getElementById('eventTimeStart') as HTMLInputElement).value : null,
            timeEnd:     timeMode === 'range'  ? (document.getElementById('eventTimeEnd') as HTMLInputElement).value  : null,
            location:    (document.getElementById('eventLocation') as HTMLInputElement).value.trim(),
            description: (document.getElementById('eventDescription') as HTMLTextAreaElement).value.trim(),
            isFree:      (document.getElementById('isFree') as HTMLInputElement).checked,
            isForKids:   (document.getElementById('isForKids') as HTMLInputElement).checked,
            isMusic:     (document.getElementById('isMusic') as HTMLInputElement).checked,
            isSport:     (document.getElementById('isSport') as HTMLInputElement).checked,
            isMarket:    (document.getElementById('isMarket') as HTMLInputElement).checked,
            isTheatre:   (document.getElementById('isTheatre') as HTMLInputElement).checked,
            url:         (document.getElementById('eventUrl') as HTMLInputElement).value.trim() || null,
        };

        if (baseEvent.endDate && baseEvent.endDate < baseEvent.date) {
            submitBtn.textContent = originalText;
            submitBtn.disabled = false;
            alert('The end date must be on or after the start date.');
            return;
        }

        const isRecurring = (document.getElementById('isRecurring') as HTMLInputElement).checked;

        if (isRecurring) {
            const recEndDate = (document.getElementById('recurrenceEndDate') as HTMLInputElement).value;
            const frequency  = (document.getElementById('recurrenceFrequency') as HTMLSelectElement).value;
            if (!recEndDate || recEndDate <= baseEvent.date) {
                submitBtn.textContent = originalText;
                submitBtn.disabled = false;
                alert('Please set a "Repeat until" date that is after the event start date.');
                return;
            }
            try {
                const response = await fetch('/.netlify/functions/submit-recurring', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ baseEvent, recurrence: { frequency, endDate: recEndDate } })
                });
                const result = await response.json();
                if (!response.ok) throw new Error(result.error || `Submit failed: ${response.status}`);
                closeModal('submitModal');
                (document.getElementById('eventForm') as HTMLFormElement).reset();
                alert(`Events Submitted!\n\nThanks for your help! Your ${result.count} events have been submitted. They'll appear once approved.\n\nQuestions? Email me at naastoday.tile693@passinbox.com`);
            } catch (error) {
                console.error('Error submitting recurring events:', error);
                alert('Sorry, something went wrong. Please try again or email naastoday.tile693@passinbox.com.');
            } finally {
                submitBtn.textContent = originalText;
                submitBtn.disabled = false;
            }
        } else {
            try {
                const response = await fetch('/.netlify/functions/submit-event', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(baseEvent)
                });
                if (!response.ok) throw new Error(`Submit failed: ${response.status}`);
                closeModal('submitModal');
                (document.getElementById('eventForm') as HTMLFormElement).reset();
                alert('Event Submitted! 🎉\n\nThanks for your help! I\'ll review your submission and it should appear on the site within a day or two.\n\nQuestions? Email me at naastoday.tile693@passinbox.com');
            } catch (error) {
                console.error('Error submitting event:', error);
                alert('Sorry, something went wrong. Please try again or email naastoday.tile693@passinbox.com.');
            } finally {
                submitBtn.textContent = originalText;
                submitBtn.disabled = false;
            }
        }
    });

    // ESC key + backdrop click
    document.querySelectorAll<HTMLElement>('.modal').forEach(modal => {
        modal.addEventListener('click', (e) => {
            if (e.target === modal) {
                closeModal(modal.id);
                if (modal.id === 'submitModal') (document.getElementById('eventForm') as HTMLFormElement).reset();
            }
        });
    });

    document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        const activeModal = document.querySelector<HTMLElement>('.modal.active');
        if (activeModal) {
            closeModal(activeModal.id);
            if (activeModal.id === 'submitModal') (document.getElementById('eventForm') as HTMLFormElement).reset();
        }
    });
</script>
