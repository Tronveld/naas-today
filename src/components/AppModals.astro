---
import AboutModal from './modals/AboutModal.astro';
import ContactModal from './modals/ContactModal.astro';
import SubmitEventModal from './modals/SubmitEventModal.astro';
---
<AboutModal />
<ContactModal />
<SubmitEventModal />

<script>
    // Used by pages that are not index.astro — currently /terms. All behaviour
    // lives in the shared module; a draft started on `/` has to still be there
    // here, and the About/Contact modals have to behave the same way.
    import { initModals, initSubmitForm } from '../scripts/modal-form.js';

    function localDateStr(date: Date): string {
        const y = date.getFullYear();
        const m = String(date.getMonth() + 1).padStart(2, '0');
        const d = String(date.getDate()).padStart(2, '0');
        return `${y}-${m}-${d}`;
    }

    initModals();
    // No date navigation on these pages, so the default is simply today.
    initSubmitForm({ defaultDate: () => localDateStr(new Date()) });
</script>
