---
import EventCard from './EventCard.astro';

interface Event {
  id: string;
  title: string;
  date: string;
  end_date?: string;
  time?: string;
  time_end?: string;
  is_all_day?: boolean;
  location: string;
  description: string;
  is_free?: boolean;
  is_for_kids?: boolean;
  is_music?: boolean;
  is_sport?: boolean;
  is_market?: boolean;
  is_theatre?: boolean;
  url?: string;
}

interface Props {
  events: Event[];
  todayStr: string;
}

const { events, todayStr } = Astro.props;

// Filter to today's events for initial server render
const todayEvents = events.filter(e => {
  if (e.end_date) return e.date <= todayStr && e.end_date >= todayStr;
  return e.date === todayStr;
}).sort((a, b) => (a.time || '').localeCompare(b.time || ''));
---
<div class="events-container" aria-live="polite" aria-atomic="false">
    <div class="events-grid" id="eventsGrid" style={todayEvents.length === 0 ? 'display:none' : 'display:grid'}>
        {todayEvents.map(event => <EventCard event={event} />)}
    </div>

    <div class="empty-state" id="emptyState" class:list={[{ visible: todayEvents.length === 0 }]}>
        <div class="empty-icon" aria-hidden="true">
            <svg width="48" height="48" viewBox="0 0 48 48" fill="none">
                <rect x="8" y="6" width="32" height="36" rx="4" stroke="var(--ink-light)" stroke-width="2" fill="none"/>
                <line x1="8" y1="16" x2="40" y2="16" stroke="var(--ink-light)" stroke-width="2"/>
                <circle cx="17" cy="11" r="1.5" fill="var(--ink-light)"/>
                <circle cx="31" cy="11" r="1.5" fill="var(--ink-light)"/>
                <line x1="15" y1="24" x2="33" y2="24" stroke="var(--border)" stroke-width="2" stroke-linecap="round"/>
                <line x1="15" y1="30" x2="27" y2="30" stroke="var(--border)" stroke-width="2" stroke-linecap="round"/>
            </svg>
        </div>
        <h3>Quiet day in Naas</h3>
        <p>Nothing listed yet — know of something happening? Add it to the noticeboard.</p>
        <button class="submit-area-btn" style="margin-top: 1rem;" onclick="document.getElementById('eventDate').value = localDateStr(currentDate); openModal('submitModal');">Submit an event</button>
    </div>

    <div class="loading-state" id="loadingState">
        <div class="skeleton-grid" aria-label="Loading events" role="status">
            <div class="skeleton-card"><div class="skeleton-line skeleton-title"></div><div class="skeleton-line skeleton-loc"></div><div class="skeleton-line skeleton-desc"></div><div class="skeleton-line skeleton-desc-short"></div></div>
            <div class="skeleton-card"><div class="skeleton-line skeleton-title"></div><div class="skeleton-line skeleton-loc"></div><div class="skeleton-line skeleton-desc"></div><div class="skeleton-line skeleton-desc-short"></div></div>
        </div>
    </div>

    <div class="error-state" id="errorState">
        <h3>Couldn't load events</h3>
        <p>Something went sideways on our end. Give it another go.</p>
        <button class="submit-area-btn" style="margin-top: 1rem;" onclick="fetchEvents()">Try again</button>
    </div>

    <!-- Hidden whenever the empty or error state is showing: both carry their
         own button, and two stacked green CTAs is worse than one. -->
    <div class="submit-area" id="submitArea" style={todayEvents.length === 0 ? 'display:none' : ''}>
        <button class="submit-area-btn" id="submitEventBtn">+ Submit an event</button>
    </div>
</div>
