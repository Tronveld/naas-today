---
import EventCard from './EventCard.astro';

interface Event {
  id: string;
  title: string;
  date: string;
  end_date?: string;
  time?: string;
  time_end?: string;
  is_all_day?: boolean;
  location: string;
  description: string;
  is_free?: boolean;
  is_for_kids?: boolean;
  is_music?: boolean;
  is_sport?: boolean;
  is_market?: boolean;
  is_theatre?: boolean;
  url?: string;
}

interface Props {
  events: Event[];
  todayStr: string;
}

const { events, todayStr } = Astro.props;

// Filter to today's events for initial server render
const todayEvents = events.filter(e => {
  if (e.end_date) return e.date <= todayStr && e.end_date >= todayStr;
  return e.date === todayStr;
}).sort((a, b) => (a.time || '').localeCompare(b.time || ''));
---
<!-- The status node carries the announcement instead of the container. A live
     region around the whole list made every filter tap re-read each card in
     full, descriptions included, rather than "3 events". -->
<p id="eventsStatus" class="visually-hidden" role="status" aria-live="polite"></p>

<!-- Shown when a refresh failed but pre-rendered events are still on screen.
     The page works, so this is a note rather than the error state. -->
<p class="stale-note" id="staleNote" hidden>
    Couldn't check for updates just now — showing the last saved listings.
</p>

<div class="events-container">
    <div class="events-grid" id="eventsGrid" style={todayEvents.length === 0 ? 'display:none' : 'display:grid'}>
        {todayEvents.map(event => <EventCard event={event} />)}
    </div>

    <!-- Never shown for a genuinely empty day any more: the band above says
         "Nothing on today." at display size and then names the next real event,
         so a second panel underneath repeating it in smaller type was the same
         answer twice. It survives for the one case the band cannot describe —
         a day whose events exist but are hidden by active filters, which needs
         different words and an escape. Dormant while FILTERS_ENABLED is false. -->
    <div id="emptyState" class="empty-state">
        <h3 id="emptyHeading">No matching events</h3>
        <p id="emptyMessage"></p>
        <button class="empty-clear-btn" id="clearFiltersBtn" hidden>Show all events</button>
    </div>

    <div class="loading-state" id="loadingState">
        <div class="skeleton-grid" aria-label="Loading events" role="status">
            <div class="skeleton-card"><div class="skeleton-line skeleton-title"></div><div class="skeleton-line skeleton-loc"></div><div class="skeleton-line skeleton-desc"></div><div class="skeleton-line skeleton-desc-short"></div></div>
            <div class="skeleton-card"><div class="skeleton-line skeleton-title"></div><div class="skeleton-line skeleton-loc"></div><div class="skeleton-line skeleton-desc"></div><div class="skeleton-line skeleton-desc-short"></div></div>
        </div>
    </div>

    <div class="error-state" id="errorState">
        <h3>Couldn't load events</h3>
        <p>Something went sideways on our end. Give it another go.</p>
        <button class="submit-area-btn" style="margin-top: 1rem;" id="retryBtn">Try again</button>
    </div>
</div>
