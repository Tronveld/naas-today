---
interface Event {
  id: string;
  title: string;
  date: string;
  end_date?: string;
  time?: string;
  time_end?: string;
  is_all_day?: boolean;
  location: string;
  description: string;
  is_free?: boolean;
  is_for_kids?: boolean;
  url?: string;
}

interface Props {
  event: Event;
}

const { event } = Astro.props;

function formatTime(time: string): string {
  const [hours, minutes] = time.substring(0, 5).split(':');
  const hour = parseInt(hours);
  const ampm = hour >= 12 ? 'PM' : 'AM';
  const displayHour = hour % 12 || 12;
  return `${displayHour}:${minutes} ${ampm}`;
}

function formatEventTime(e: Event): string {
  if (e.is_all_day) return 'All day';
  const t = e.time ? e.time.substring(0, 5) : '';
  if (!t) return '';
  const start = formatTime(t);
  if (e.time_end) return start + ' – ' + formatTime(e.time_end);
  return start;
}

const timeStr = formatEventTime(event);
const mapsUrl = `https://maps.google.com/?q=${encodeURIComponent(event.location + ', Naas, Ireland')}`;

let parsedUrl: URL | null = null;
if (event.url) {
  try {
    const u = new URL(event.url);
    if (u.protocol === 'http:' || u.protocol === 'https:') parsedUrl = u;
  } catch {
    // invalid URL
  }
}
---
<div class="event-card">
  {timeStr && <div class="event-time">{timeStr}</div>}
  <h3 class="event-title">{event.title}</h3>
  <a class="event-location" href={mapsUrl} target="_blank" rel="noopener noreferrer">📍 {event.location}</a>
  <p class="event-description">{event.description}</p>
  {parsedUrl && (
    <a class="event-url" href={parsedUrl.href} target="_blank" rel="noopener noreferrer">
      🔗 {parsedUrl.hostname.replace(/^www\./, '')}
    </a>
  )}
  <div class="card-footer">
    <div class="event-tags">
      {event.is_free && <span class="tag free">Free</span>}
      {event.is_for_kids && <span class="tag kids">For kids</span>}
    </div>
    <button class="share-btn" aria-label={`Share ${event.title}`} data-share-title={event.title} data-share-date={event.date} data-share-time={event.time || ''} data-share-time-end={event.time_end || ''} data-share-location={event.location} data-share-allday={event.is_all_day ? 'true' : 'false'}>Share ↗</button>
  </div>
</div>
