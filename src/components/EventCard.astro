---
import { timeRangeLabel } from '../scripts/date.js';
import { DESCRIPTION_CLAMP } from '../scripts/flags.js';

interface Event {
  id: string;
  title: string;
  date: string;
  end_date?: string;
  time?: string;
  time_end?: string;
  is_all_day?: boolean;
  location: string;
  description: string;
  is_free?: boolean;
  is_for_kids?: boolean;
  is_music?: boolean;
  is_sport?: boolean;
  is_market?: boolean;
  is_theatre?: boolean;
  url?: string;
}

interface Props {
  event: Event;
}

const { event } = Astro.props;

function formatDateShort(dateStr: string): string {
  const d = new Date(dateStr + 'T00:00:00');
  return d.toLocaleDateString('en-IE', { day: 'numeric', month: 'short' });
}

const mapsUrl = `https://maps.google.com/?q=${encodeURIComponent(event.location + ', Naas, Ireland')}`;

// The card names a place, not an address. Scraped locations arrive as
// "Naas Potato Market, Church Lane, Naas, Co. Kildare", and the street is not
// why anyone reads the card. The full string still goes to Maps and to `title`.
const venue = event.location.split(',')[0].trim() || event.location;

let parsedUrl: URL | null = null;
if (event.url) {
  try {
    const u = new URL(event.url);
    if (u.protocol === 'http:' || u.protocol === 'https:') parsedUrl = u;
  } catch {
    // invalid URL
  }
}

// One line, first, in the accent — the time leads the card now rather than
// sitting in a pill opposite the title. Every case resolves to a string, so the
// slot is never empty and a mixed list of timed, all-day and TBC events keeps
// one shape. `time_end` is shown; the old pill dropped it silently.
const isMultiDay = event.end_date && event.end_date !== event.date;
const span = isMultiDay ? `${formatDateShort(event.date)} – ${formatDateShort(event.end_date!)}` : '';
const clock = event.time ? timeRangeLabel(event.time, event.time_end) : '';
// A multi-day run with a start time gets both. The old pill could hold one fact
// in 28px, so a festival running 15–16 August at 12pm showed the dates and threw
// the time away; a full-width line has room for the answer to "when do I go".
const when = event.is_all_day
  ? (span ? `${span} · All day` : 'All day')
  : span
    ? (clock ? `${span} · ${clock}` : span)
    : clock || 'Time TBC';

const desc = event.description ?? '';
const isLong = desc.length > DESCRIPTION_CLAMP;
---
<article class="event-card" data-event-id={event.id} aria-labelledby={"event-title-" + event.id}>
  <div class="ev-when">{when}</div>
  {/* The title is the link when there is somewhere to go: it is where every
      listing site puts the click, and it was the one tap that did nothing. */}
  <h3 class="event-title" id={"event-title-" + event.id}>
    {parsedUrl
      ? <a href={parsedUrl.href} target="_blank" rel="noopener noreferrer">{event.title}</a>
      : event.title}
  </h3>
  <a class="event-location" href={mapsUrl} title={event.location} target="_blank" rel="noopener noreferrer">{venue}</a>
  {desc && (
    <p
      class="event-description"
      data-truncatable={isLong ? 'true' : undefined}
      style={isLong ? 'margin-bottom: 0;' : undefined}
    >
      {desc}
    </p>
  )}
  {isLong && (
    <button class="desc-toggle-btn" aria-expanded="false" type="button">Read more</button>
  )}
  {/* Share closes the card, opposite the tags: it is an action on the whole
      event, not a fact about where it is. As text, not the bordered box it once
      was here — see DESIGN.md's Text-Action Rule. */}
  <div class="card-footer">
    <div class="event-tags">
      {event.is_free && <span class="tag">Free</span>}
      {event.is_for_kids && <span class="tag">For kids</span>}
      {event.is_music && <span class="tag">Music</span>}
      {event.is_sport && <span class="tag">Sport</span>}
      {event.is_market && <span class="tag">Market</span>}
      {event.is_theatre && <span class="tag">Theatre</span>}
    </div>
    <button class="share-btn" data-umami-event="share" aria-label={`Share ${event.title}`}>Share</button>
  </div>
</article>
