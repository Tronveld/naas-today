<div class="controls">
    <div class="controls-inner">
        <span class="controls-label">Filter:</span>
        <div class="filter-group">
            <button class="filter-btn" id="filterFree" aria-pressed="false">
                <span>Free</span>
            </button>
            <button class="filter-btn" id="filterKids" aria-pressed="false">
                <span>For kids</span>
            </button>
            <button class="filter-btn" id="filterMusic" aria-pressed="false">
                <span>Music</span>
            </button>
            <button class="filter-btn" id="filterSport" aria-pressed="false">
                <span>Sport</span>
            </button>
            <button class="filter-btn" id="filterMarket" aria-pressed="false">
                <span>Markets</span>
            </button>
            <button class="filter-btn" id="filterTheatre" aria-pressed="false">
                <span>Theatre</span>
            </button>
        </div>
        <button class="submit-btn" id="submitEventBtn" style="margin-left: auto">Submit event</button>
    </div>
</div>
