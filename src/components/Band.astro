---
interface Props {
  /** Omitted on pages that are not the day view (/terms) — brand only. */
  dateStr?: string;
}

const { dateStr } = Astro.props;

// One row on every day: brand left, the date right, set to be read. The band
// used to carry the day's answer too — "Four things on today." repeated the
// strip's count, and an empty day's "Nothing on Monday." plus the next event
// took most of the first screen. Both answers now live where the cards do.
const longDate = dateStr
  ? new Date(dateStr + 'T00:00:00').toLocaleDateString('en-IE', {
      weekday: 'long', day: 'numeric', month: 'long',
    })
  : '';
---
<header class:list={['band', { 'is-day': dateStr }]}>
  <div class="container">
    <div class="band-top">
      <span class="band-brand">Naas Today</span>
      {dateStr
        ? <span class="band-date" id="currentDateDisplay">{longDate}</span>
        : <span class="band-date">What's on in Naas</span>}
    </div>
  </div>
</header>
