# Local Netlify folder
.netlify
.env
.worktrees

# Claude Code local state — may contain machine-specific paths and secrets.
# Also covered by the global ignore, but that doesn't travel with the repo.
.claude/settings.local.json
.claude/worktrees/

# Dependencies
node_modules/

# Build output / local caches
dist/
.astro/
.superpowers/

# Generated by netlify dev's Deno edge bundling; this project has no edge functions
deno.lock

# macOS
.DS_Store

# Impeccable decision-server state: pids, ports and heartbeats from a local
# question page. Transient and machine-specific; the durable record of what was
# decided lives in .impeccable/mocks/.
.impeccable/questions/
